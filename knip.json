{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gitleaks"],
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/platform/database/seed/seed-main.ts",
        "src/platform/index.ts",
        "src/modules/iam/index.ts",
        "src/modules/core/index.ts",
        "src/modules/doc/index.ts",
        "src/modules/wf/index.ts",
        "src/modules/ntf/index.ts",
        "src/modules/crm/index.ts",
        "src/modules/contract/index.ts",
        "src/modules/project/index.ts",
        "src/modules/iam/interface/cli/invite-main.ts",
        "src/modules/iam/interface/cli/reset-second-factor-main.ts",
        "src/modules/iam/interface/cli/assign-role-main.ts",
        "src/modules/doc/interface/cli/import-master-list-main.ts",
        "src/modules/doc/interface/cli/import-retention-main.ts",
        "src/modules/contract/interface/cli/link-signer-main.ts"
      ],
      "ignoreDependencies": ["@prisma/client"]
    },
    "apps/worker": {
      "entry": ["src/main.ts", "src/healthcheck.ts", "src/cli/enqueue-example.ts"]
    },
    "infra/migrate": {
      "ignoreDependencies": ["prisma"]
    }
  }
}
