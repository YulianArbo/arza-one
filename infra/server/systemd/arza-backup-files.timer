# copia diaria de los archivos, 3:00 a. m. de Colombia (B44). Horas en UTC: Colombia es UTC-5.
[Unit]
Description=ARZA ONE: copia diaria de los archivos, 3:00 a. m. de Colombia

[Timer]
OnCalendar=*-*-* 08:00:00
Persistent=true
RandomizedDelaySec=5min
Unit=arza-backup@files.service

[Install]
WantedBy=timers.target
