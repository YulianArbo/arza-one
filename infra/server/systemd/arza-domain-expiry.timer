# vencimiento del dominio, cada día a las 7:00 a. m. de Colombia (B44). Horas en UTC: Colombia es UTC-5.
[Unit]
Description=ARZA ONE: vencimiento del dominio, cada día a las 7:00 a. m. de Colombia

[Timer]
OnCalendar=*-*-* 12:00:00
Persistent=true
RandomizedDelaySec=5min
Unit=arza-domain-expiry.service

[Install]
WantedBy=timers.target
