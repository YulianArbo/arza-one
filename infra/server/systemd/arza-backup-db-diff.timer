# copia diferencial de la base, lunes a sábado 2:00 a. m. de Colombia (B44). Horas en UTC: Colombia es UTC-5.
[Unit]
Description=ARZA ONE: copia diferencial de la base, lunes a sábado 2:00 a. m. de Colombia

[Timer]
OnCalendar=Mon..Sat *-*-* 07:00:00
Persistent=true
RandomizedDelaySec=5min
Unit=arza-backup@db-diff.service

[Install]
WantedBy=timers.target
