{
  "name": "arza-one",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:types": "turbo run build --filter=./packages/* --filter=@arza/api --output-logs=errors-only",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "e2e:install": "pnpm --filter @arza/web e2e:install",
    "env:local": "node infra/scripts/local/env-local.ts",
    "infra:up": "node infra/scripts/local/infra.ts up",
    "infra:down": "node infra/scripts/local/infra.ts down",
    "infra:reset": "node infra/scripts/local/infra.ts reset",
    "infra:status": "node infra/scripts/local/infra.ts status",
    "job:ejemplo": "pnpm --filter @arza/worker job:ejemplo",
    "db:migrate": "pnpm --filter @arza/api db:migrate",
    "db:seed": "turbo run build --filter=@arza/api --output-logs=errors-only && pnpm --filter @arza/api db:seed",
    "db:seed:demo": "turbo run build --filter=@arza/api --output-logs=errors-only && pnpm --filter @arza/api db:seed:demo",
    "iam:invitar": "turbo run build --filter=@arza/api --output-logs=errors-only && pnpm --filter @arza/api iam:invitar",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "unused": "knip",
    "secrets": "gitleaks git --no-banner --redact",
    "check": "pnpm format:check && pnpm build:types && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm unused && pnpm test && pnpm test:int && pnpm build && pnpm test:e2e && pnpm secrets"
  },
  "devDependencies": {
    "@arza/config": "workspace:*",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
