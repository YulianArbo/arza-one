{
  "name": "@arza/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../infra/scripts/local/dev-watch.ts dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts --coverage",
    "job:ejemplo": "node --env-file-if-exists=../../.env dist/cli/enqueue-example.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@arza/api": "workspace:*",
    "@arza/templates": "workspace:*",
    "@nestjs/common": "~11.2.7",
    "@nestjs/core": "~11.2.7",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "nodemailer": "~10.0.15",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
