    "/v1/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Datos del perfil propio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse_Output"
                }
              }
            }
          },
          "429": {
            "description": "Límite de peticiones superado",
