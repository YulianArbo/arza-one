  "info": {
    "title": "ARZA ONE API",
    "description": "Interfaz de programación de ARZA ONE (capítulo 14 del Manual MN-TEC-002).",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "ok si todas las piezas responden"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ],
                "description": "PostgreSQL"
              },
              "queues": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ],
                "description": "Valkey (colas y caché)"
              },
              "files": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ],
                "description": "Almacenamiento de archivos S3"
              }
            },
            "required": [
              "database",
              "queues",
              "files"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "ErrorResponse_Output": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Código estable del error, por ejemplo QUOTE_EXPIRED"
              },
              "message": {
                "type": "string",
                "description": "Mensaje para la persona, en español"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Campo con el problema, en notación de puntos"
                    },
                    "issue": {
                      "type": "string",
                      "description": "Código del problema, por ejemplo too_small o invalid_type"
                    }
                  },
                  "required": [
                    "field",
                    "issue"
                  ],
                  "additionalProperties": false
                }
              },
              "correlation_id": {
                "type": "string",
                "description": "Identificador de la petición en los registros"
              }
            },
            "required": [
              "code",
              "message",
              "details",
              "correlation_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "VersionResponse_Output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "Versión semántica de la API"
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "staging",
              "production"
            ],
            "description": "Ambiente de ejecución"
          },
          "commit": {
            "type": "string",
            "description": "Commit desplegado, o unknown si no se informó"
          }
        },
        "required": [
          "version",
          "environment",
          "commit"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "description": "Correo electrónico",
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Contraseña"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionResponse_Output": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "internal",
                  "portal"
                ],
                "description": "Aplicación interna o portal"
              }
            },
            "required": [
              "id",
              "email",
              "display_name",
              "kind"
            ],
            "additionalProperties": false
          },
          "csrf_token": {
            "type": "string",
            "description": "Código antifalsificación de esta sesión"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "Vencimiento total de la sesión"
          }
        },
        "required": [
          "user",
          "csrf_token",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "description": "Correo electrónico",
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "AcknowledgementResponse_Output": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Mensaje para la persona"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[\\w-]{43}$",
            "description": "Llave del enlace recibido por correo"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Contraseña"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "AcceptInvitationRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[\\w-]{43}$",
            "description": "Llave del enlace recibido por correo"
          },
          "display_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Nombre con el que se mostrará"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Contraseña"
          }
        },
        "required": [
          "token",
          "display_name",
          "password"
        ]
      },
      "MeResponse_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "display_name": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "internal",
              "portal"
            ],
            "description": "Aplicación interna o portal"
          },
          "last_login_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "password_changed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "kind",
          "last_login_at",
          "password_changed_at"
        ],
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "current_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Contraseña"
          },
          "new_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Contraseña"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ]
      }
    }
  }
}
