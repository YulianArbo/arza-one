    "/v1/me/password": {
      "post": {
        "operationId": "MeController_password",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Contraseña cambiada"
          },
          "422": {
            "description": "Contraseña actual incorrecta o contraseña nueva que no cumple las reglas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
