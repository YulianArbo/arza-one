{
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Todo responde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse_Output"
                }
              }
            }
          },
          "429": {
            "description": "Límite de peticiones superado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado; incluye el identificador de correlación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          },
          "503": {
            "description": "Al menos una pieza no responde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse_Output"
                }
              }
            }
          }
        },
        "summary": "Estado de la API y de la base de datos, las colas y los archivos",
        "tags": [
          "Plataforma"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "VersionController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse_Output"
                }
              }
            }
          },
          "429": {
            "description": "Límite de peticiones superado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado; incluye el identificador de correlación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          }
        },
        "summary": "Versión, ambiente y commit de la API",
        "tags": [
          "Plataforma"
        ]
      }
    }
  },
  "info": {
    "title": "ARZA ONE API",
    "description": "Interfaz de programación de ARZA ONE (capítulo 14 del Manual MN-TEC-002).",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponse_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "description": "ok si todas las piezas responden"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ],
                "description": "PostgreSQL"
              },
              "queues": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ],
                "description": "Valkey (colas y caché)"
              },
              "files": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ],
                "description": "Almacenamiento de archivos S3"
              }
            },
            "required": [
              "database",
              "queues",
              "files"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "ErrorResponse_Output": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Código estable del error, por ejemplo QUOTE_EXPIRED"
              },
              "message": {
                "type": "string",
                "description": "Mensaje para la persona, en español"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Campo con el problema, en notación de puntos"
                    },
                    "issue": {
                      "type": "string",
                      "description": "Código del problema, por ejemplo too_small o invalid_type"
                    }
                  },
                  "required": [
                    "field",
                    "issue"
                  ],
                  "additionalProperties": false
                }
              },
              "correlation_id": {
                "type": "string",
                "description": "Identificador de la petición en los registros"
              }
            },
            "required": [
              "code",
              "message",
              "details",
              "correlation_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "VersionResponse_Output": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "Versión semántica de la API"
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "staging",
              "production"
            ],
            "description": "Ambiente de ejecución"
          },
          "commit": {
            "type": "string",
            "description": "Commit desplegado, o unknown si no se informó"
          }
        },
        "required": [
          "version",
          "environment",
          "commit"
        ],
        "additionalProperties": false
      }
    }
  }
}
