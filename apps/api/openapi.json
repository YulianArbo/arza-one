              }
            }
          },
          "429": {
            "description": "Límite de peticiones superado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado; incluye el identificador de correlación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          }
        },
        "summary": "Crear una contraseña nueva con el enlace del correo",
        "tags": [
          "Identidad"
        ]
      }
    },
    "/v1/auth/invitation/accept": {
      "post": {
        "operationId": "AuthController_accept",
        "parameters": [],
        "requestBody": {
          "required": true,
