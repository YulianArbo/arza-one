            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cuenta activa"
          },
          "422": {
            "description": "Enlace inválido o vencido, o contraseña que no cumple las reglas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          },
          "429": {
            "description": "Límite de peticiones superado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado; incluye el identificador de correlación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          }
        },
