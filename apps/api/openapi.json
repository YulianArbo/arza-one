                  "$ref": "#/components/schemas/ErrorResponse_Output"
                }
              }
            }
          }
        },
        "summary": "Pedir un enlace para crear una contraseña nueva",
        "tags": [
          "Identidad"
        ]
      }
    },
    "/v1/auth/password/reset": {
