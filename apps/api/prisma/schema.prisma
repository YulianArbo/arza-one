}

/// Vacantes (B35, ficha 17.13): un cargo del organigrama por cubrir, con su código VAC-AAAA-NNNN.
model HrVacancy {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  code        String
  positionId  String        @map("position_id") @db.Uuid
