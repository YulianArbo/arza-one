// Modelo de datos de ARZA ONE (capítulo 12). Las tablas llevan el prefijo de su dominio y las
// columnas de control del numeral 12.1. La seguridad por fila, los permisos de app_user y los
// disparadores de las columnas de control viven en el SQL de cada migración, porque Prisma no
// los expresa.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Empresas inquilinas (M00). La fila de una empresa solo es visible dentro de su propio contexto.
model Tenant {
  id              String               @id @default(uuid(7)) @db.Uuid
  legalName       String               @map("legal_name")
  tradeName       String?              @map("trade_name")
  taxId           String               @unique @map("tax_id")
  status          String               @default("active")
  settings        Json                 @default("{}")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?              @map("created_by") @db.Uuid
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?              @map("updated_by") @db.Uuid
  version         Int                  @default(1)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(6)
  outboxEvents    OutboxEvent[]
  users           User[]
  sessions        Session[]
  tokens          Token[]
  loginAttempts   LoginAttempt[]
  mfaFactors      MfaFactor[]
  recoveryCodes   RecoveryCode[]
  knownDevices    KnownDevice[]
  roles           Role[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  delegations     Delegation[]
  auditEvents     AuditEvent[]
  auditChainHead  AuditChainHead?
  auditExports    AuditExport[]
  securityEvents  SecurityEvent[]
  sites           Site[]
  orgUnits        OrgUnit[]
  positions       Position[]
  costCenters     CostCenter[]
  catalogs        Catalog[]
  catalogItems    CatalogItem[]
  sequences       Sequence[]
  parameters      Parameter[]
  holidays        Holiday[]
  parties         Party[]
  partyRoles      PartyRole[]
  contacts        Contact[]
  bankAccounts    BankAccount[]
  dueDiligence    DueDiligence[]
  files           File[]
  wfDefinitions   WorkflowDefinition[]
  wfStates        WorkflowState[]
  wfTransitions   WorkflowTransition[]
  wfInstances     WorkflowInstance[]
  wfHistory       WorkflowHistory[]
  wfTasks         WorkflowTask[]
  wfApprovals     WorkflowApproval[]

  @@map("core_tenants")
}

/// Eventos de dominio pendientes de publicar (bandeja de salida, numeral 13.2).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  schemaVersion Int       @default(1) @map("schema_version")
  payload       Json
  actorId       String?   @map("actor_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@map("core_outbox_events")
}

/// Cuentas de usuario (M01). El correo es único en toda la plataforma: con él se sabe a qué
/// empresa pertenece la persona al iniciar sesión.
model User {
  id                  String         @id @default(uuid(7)) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  email               String         @unique
  displayName         String?        @map("display_name")
  passwordHash        String?        @map("password_hash")
  kind                String
  status              String         @default("invited")
  partyId             String?        @map("party_id") @db.Uuid
  positionId          String?        @map("position_id") @db.Uuid
  mfaRequired         Boolean        @default(true) @map("mfa_required")
  lastLoginAt         DateTime?      @map("last_login_at") @db.Timestamptz(6)
  lockedUntil         DateTime?      @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt   DateTime?      @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?        @map("created_by") @db.Uuid
  updatedAt           DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?        @map("updated_by") @db.Uuid
  version             Int            @default(1)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions            Session[]
  tokens              Token[]
  loginAttempts       LoginAttempt[]
  mfaFactors          MfaFactor[]
  recoveryCodes       RecoveryCode[]
  knownDevices        KnownDevice[]
  roleAssignments     UserRole[]
  delegationsGiven    Delegation[]   @relation("DelegationsGiven")
  delegationsReceived Delegation[]   @relation("DelegationsReceived")
  position            Position?      @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, positionId])
  @@map("iam_users")
}

/// Sesiones (numeral 15.1). Solo se guarda la huella SHA-256 de la llave de la cookie. Una sesión
/// sin authenticated_at solo verificó la contraseña: le falta el segundo factor (B09).
model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash")
  ip                String?
  userAgent         String?      @map("user_agent")
  deviceId          String?      @map("device_id") @db.Uuid
  authenticatedAt   DateTime?    @map("authenticated_at") @db.Timestamptz(6)
  reauthenticatedAt DateTime?    @map("reauthenticated_at") @db.Timestamptz(6)
  lastSeenAt        DateTime     @map("last_seen_at") @db.Timestamptz(6)
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?      @map("revoked_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?      @map("created_by") @db.Uuid
  updatedAt         DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?      @map("updated_by") @db.Uuid
  version           Int          @default(1)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  device            KnownDevice? @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, deviceId])
  @@map("iam_sessions")
}

/// Segundo factor TOTP (B09). Una fila por persona y tipo. El secreto se guarda cifrado con
/// FIELD_ENCRYPTION_KEY (capítulo 12.1); mientras se configura, el nuevo espera en pending_*.
model MfaFactor {
  id                     String    @id @default(uuid(7)) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  type                   String    @default("totp")
  secretEncrypted        String?   @map("secret_encrypted")
  confirmedAt            DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedStep           Int?      @map("last_used_step")
  pendingSecretEncrypted String?   @map("pending_secret_encrypted")
  pendingExpiresAt       DateTime? @map("pending_expires_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?   @map("updated_by") @db.Uuid
  version                Int       @default(1)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                   User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, userId, type])
  @@map("iam_mfa_factors")
}

/// Códigos de recuperación del segundo factor (B09): diez, de un solo uso. Solo su huella.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@map("iam_recovery_codes")
}

/// Equipos desde los que una persona ya entró (B09), para avisar de un dispositivo nuevo
/// (numeral 15.5). Solo la huella de la marca aleatoria que guarda el navegador.
model KnownDevice {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceHash  String    @map("device_hash")
  userAgent   String?   @map("user_agent")
  firstSeenAt DateTime  @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  sessions    Session[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId, deviceHash])
  @@map("iam_known_devices")
}

/// Enlaces de un solo uso: invitación y recuperación de contraseña. Solo se guarda su huella.
model Token {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId, purpose])
  @@map("iam_tokens")
}

/// Intentos de inicio de sesión. tenant_id queda vacío cuando el correo no tiene cuenta: esas
/// filas solo las leen y escriben las funciones de inicio de sesión de la migración.
model LoginAttempt {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  email      String
  ip         String?
  succeeded  Boolean
  reason     String
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User?     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([email, occurredAt])
  @@index([tenantId, userId])
  @@map("iam_login_attempts")
}

/// Catálogo de permisos del anexo G (B10). Es el mismo para todas las empresas: no lleva
/// tenant_id. Lo carga la semilla desde packages/contracts; la API solo lo lee.
model Permission {
  id              String           @id @default(uuid(7)) @db.Uuid
  code            String           @unique
  resource        String
  action          String
  groupKey        String           @map("group_key")
  level           String
  ownable         Boolean
  description     String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?          @map("updated_by") @db.Uuid
  version         Int              @default(1)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("iam_permissions")
}

/// Roles de cada empresa (numeral 15.2): los 16 del sistema, que no se editan, y los
/// personalizados. Nunca se borran.
model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean          @map("is_system")
  audience    String
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?          @map("updated_by") @db.Uuid
  version     Int              @default(1)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("iam_roles")
}

/// Permisos de cada rol. conditions vacío es «todo»; {"scope": "own"} es «solo lo propio»
/// (letra P). Un permiso retirado de un rol personalizado queda con deleted_at.
model RolePermission {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  conditions   Json?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?    @map("updated_by") @db.Uuid
  version      Int        @default(1)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([tenantId, roleId])
  @@map("iam_role_permissions")
}

/// Roles de cada persona, con vigencia (ficha 17.2). Retirar un rol deja revoked_at: el
/// historial completo queda. Nadie se asigna un rol a sí mismo (assigned_by distinto de user_id).
model UserRole {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  scopeType  String?   @map("scope_type")
  scopeId    String?   @map("scope_id") @db.Uuid
  validFrom  DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  assignedBy String?   @map("assigned_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  role       Role      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("iam_user_roles")
}

/// Delegación temporal de aprobaciones (ficha 17.2): quien delega, a quién, desde, hasta y qué
/// permisos de aprobación (scope, lista de códigos). Retirarla deja revoked_at.
model Delegation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime  @map("ends_at") @db.Timestamptz(6)
  scope      Json
  reason     String
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromUser   User      @relation("DelegationsGiven", fields: [tenantId, fromUserId], references: [tenantId, id], onDelete: Restrict)
  toUser     User      @relation("DelegationsReceived", fields: [tenantId, toUserId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, fromUserId])
  @@index([tenantId, toUserId])
  @@map("iam_delegations")
}

/// Auditoría de negocio (M19), solo inserción, particionada por mes de occurred_at (ADR-012).
/// La base de datos fija seq, prev_hash y hash al insertar: lo que envíe la API se ignora.
model AuditEvent {
  id            String   @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// Posición en la cadena de la empresa: 1, 2, 3… sin saltos.
  seq           BigInt   @default(0)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  actorId       String?  @map("actor_id") @db.Uuid
  actorKind     String   @map("actor_kind")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  result        String
  changes       Json     @default("{}")
  ip            String?
  correlationId String?  @map("correlation_id")
  prevHash      String   @default("") @map("prev_hash")
  hash          String   @default("")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // En una tabla particionada la llave primaria debe incluir la columna de la partición.
  @@id([id, occurredAt])
  @@index([tenantId, seq])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@map("aud_events")
}

/// Último eslabón de la cadena de cada empresa. Solo lo escribe el disparador de aud_events; al
/// compararlo con la última fila se detecta que alguien borró los eventos más recientes.
model AuditChainHead {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  seq       BigInt
  hash      String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("aud_chain_heads")
}

/// Exportaciones de la auditoría (numeral 13.2), solo inserción. file_id queda vacío hasta que
/// exista el servicio de archivos (B14): hoy la exportación se descarga en el acto.
model AuditExport {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  requestedBy String   @map("requested_by") @db.Uuid
  scope       Json
  rowCount    Int      @map("row_count")
  fileId      String?  @map("file_id") @db.Uuid
  exportedAt  DateTime @map("exported_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, exportedAt])
  @@map("aud_exports")
}

/// Eventos de seguridad (M19), solo inserción: bloqueos de cuenta y alertas.
model SecurityEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  type       String
  userId     String?  @map("user_id") @db.Uuid
  ip         String?
  detail     Json     @default("{}")
  severity   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@map("aud_security_events")
}

/// Sedes de la empresa (M00). Solo una es la principal: la API lo garantiza al guardar.
model Site {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  city      String
  address   String
  isMain    Boolean   @default(false) @map("is_main")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("core_sites")
}

/// Procesos y áreas del mapa de procesos (MP-DG-001), con su jerarquía. Uno con registros
/// asociados no se elimina: se inactiva (ficha 17.1).
model OrgUnit {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  parentId        String?      @map("parent_id") @db.Uuid
  code            String
  name            String
  kind            String
  ownerPositionId String?      @map("owner_position_id") @db.Uuid
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?      @map("created_by") @db.Uuid
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?      @map("updated_by") @db.Uuid
  version         Int          @default(1)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent          OrgUnit?     @relation("OrgUnitTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children        OrgUnit[]    @relation("OrgUnitTree")
  ownerPosition   Position?    @relation("OrgUnitOwner", fields: [tenantId, ownerPositionId], references: [tenantId, id], onDelete: Restrict)
  positions       Position[]   @relation("PositionUnit")
  costCenters     CostCenter[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, ownerPositionId])
  @@map("core_org_units")
}

/// Cargos del organigrama (DC-SGC-001): a qué proceso pertenecen y a qué cargo reportan.
model Position {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  orgUnitId    String     @map("org_unit_id") @db.Uuid
  name         String
  reportsToId  String?    @map("reports_to_id") @db.Uuid
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?    @map("updated_by") @db.Uuid
  version      Int        @default(1)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit      OrgUnit    @relation("PositionUnit", fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)
  reportsTo    Position?  @relation("PositionTree", fields: [tenantId, reportsToId], references: [tenantId, id], onDelete: Restrict)
  subordinates Position[] @relation("PositionTree")
  ledUnits     OrgUnit[]  @relation("OrgUnitOwner")
  users        User[]

  @@unique([tenantId, id])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, reportsToId])
  @@map("core_positions")
}

/// Centros de costo, opcionalmente ligados a un proceso o área.
model CostCenter {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  orgUnitId String?   @map("org_unit_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit   OrgUnit?  @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, orgUnitId])
  @@map("core_cost_centers")
}

/// Catálogos administrables: la lista la define el sistema, sus opciones la empresa.
model Catalog {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?       @map("updated_by") @db.Uuid
  version     Int           @default(1)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items       CatalogItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("core_catalogs")
}

/// Opciones de un catálogo. Una opción que ya se usó no se borra: se inactiva.
model CatalogItem {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  catalogId String    @map("catalog_id") @db.Uuid
  code      String
  label     String
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  catalog   Catalog   @relation(fields: [tenantId, catalogId], references: [tenantId, id], onDelete: Restrict)

  @@unique([catalogId, code])
  @@index([tenantId, catalogId])
  @@map("core_catalog_items")
}

/// Consecutivos de negocio por tipo y año (ADR-021). next_value solo lo sube el servicio de
/// consecutivos, con la fila bloqueada: sin saltos ni duplicados.
model Sequence {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  name      String
  prefix    String
  year      Int
  nextValue Int       @default(1) @map("next_value")
  padding   Int       @default(4)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key, year])
  @@map("core_sequences")
}

/// Parámetros con vigencia (ficha 17.1): nunca se sobrescriben. Una vigencia nueva cierra la
/// anterior el día antes de empezar (valid_to) y la conserva.
model Parameter {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  value     Json
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key, validFrom])
  @@map("core_parameters")
}

/// Festivos para el cálculo de días hábiles. Uno retirado queda con deleted_at y se recupera si
/// se vuelve a agregar la misma fecha.
model Holiday {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  holidayDate DateTime  @map("holiday_date") @db.Date
  name        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, holidayDate])
  @@map("core_holidays")
}

/// Terceros (M02): registro único de cada persona u organización con la que la empresa se
/// relaciona. Un duplicado fusionado queda con merged_into_id y deleted_at; nunca se borra.
model Party {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  kind              String
  legalName         String?        @map("legal_name")
  tradeName         String?        @map("trade_name")
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  idType            String         @map("id_type")
  idNumber          String         @map("id_number")
  checkDigit        Int?           @map("check_digit") @db.SmallInt
  email             String?
  phone             String?
  city              String?
  address           String?
  status            String         @default("active")
  statusReason      String?        @map("status_reason")
  dataPurpose       String?        @map("data_purpose")
  dataAuthorization String?        @map("data_authorization")
  dataAuthorizedOn  DateTime?      @map("data_authorized_on") @db.Date
  mergedIntoId      String?        @map("merged_into_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?        @map("created_by") @db.Uuid
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?        @map("updated_by") @db.Uuid
  version           Int            @default(1)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mergedInto        Party?         @relation("PartyMerges", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict)
  mergedParties     Party[]        @relation("PartyMerges")
  roles             PartyRole[]
  contacts          Contact[]      @relation("OrganizationContacts")
  contactOf         Contact[]      @relation("PersonContacts")
  bankAccounts      BankAccount[]
  dueDiligence      DueDiligence[]

  @@unique([tenantId, id])
  @@unique([tenantId, idType, idNumber])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("pty_parties")
}

/// Papeles del tercero: cliente, proveedor, colaborador, contacto o candidato. Uno por papel; al
/// terminar queda inactivo y la auditoría guarda el historial.
model PartyRole {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  partyId   String    @map("party_id") @db.Uuid
  role      String
  since     DateTime  @db.Date
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party     Party     @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, partyId, role])
  @@map("pty_party_roles")
}

/// Personas de contacto de una organización, con su cargo y si firman por ella.
model Contact {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  jobTitle       String?   @map("job_title")
  isPrimary      Boolean   @default(false) @map("is_primary")
  canSign        Boolean   @default(false) @map("can_sign")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization   Party     @relation("OrganizationContacts", fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  person         Party     @relation("PersonContacts", fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, organizationId, personId])
  @@index([tenantId, personId])
  @@map("pty_contacts")
}

/// Cuentas para pagos. El número va cifrado (numeral 12.1); en claro solo los cuatro últimos
/// dígitos. La aprueba una persona distinta de quien la registró (ficha 17.3).
model BankAccount {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  partyId                String        @map("party_id") @db.Uuid
  bank                   String
  accountType            String        @map("account_type")
  accountNumberEncrypted String        @map("account_number_encrypted")
  accountLast4           String        @map("account_last4")
  status                 String        @default("pending")
  replacesId             String?       @map("replaces_id") @db.Uuid
  reviewedBy             String?       @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote             String?       @map("review_note")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?       @map("created_by") @db.Uuid
  updatedAt              DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?       @map("updated_by") @db.Uuid
  version                Int           @default(1)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(6)
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party                  Party         @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict)
  replaces               BankAccount?  @relation("BankAccountReplacements", fields: [tenantId, replacesId], references: [tenantId, id], onDelete: Restrict)
  replacedBy             BankAccount[] @relation("BankAccountReplacements")

  @@unique([tenantId, id])
  @@index([tenantId, partyId])
  @@index([tenantId, replacesId])
  @@map("pty_bank_accounts")
}

/// Conocimiento del tercero y nivel de riesgo. Lo aprueba una persona distinta de quien lo
/// registró; sin uno aprobado y vigente no se factura ni se contrata (ficha 17.3).
model DueDiligence {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  partyId      String    @map("party_id") @db.Uuid
  riskLevel    String    @map("risk_level")
  summary      String
  status       String    @default("pending")
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?   @map("review_note")
  nextReviewOn DateTime? @map("next_review_on") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party        Party     @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, partyId])
  @@map("pty_due_diligence")
}

/// Archivo físico guardado en el almacenamiento privado (M03, B14). Entra «esperando el archivo»;
/// el worker lo analiza con el antivirus, revisa que su contenido sea del tipo declarado y calcula
/// su huella SHA-256. Solo un archivo disponible se descarga (numeral 13.2, ADR-013).
model File {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  storageKey String    @map("storage_key")
  fileName   String    @map("file_name")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  sha256     String?
  scanStatus String    @default("pending_upload") @map("scan_status")
  rejection  String?
  scannedAt  DateTime? @map("scanned_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([storageKey])
  @@index([tenantId, createdBy, createdAt])
  @@map("doc_files")
}

// M04 Flujos y tareas (B15, ADR-011). Las personas se guardan por identificador, sin relación con
// las tablas de identidad: el motor las consulta por el índice del módulo iam.

model WorkflowDefinition {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  key           String
  versionNumber Int                  @map("version_number")
  name          String
  description   String?
  entityType    String               @map("entity_type")
  status        String               @default("draft")
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(6)
  publishedBy   String?              @map("published_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?              @map("created_by") @db.Uuid
  updatedAt     DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?              @map("updated_by") @db.Uuid
  version       Int                  @default(1)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  states        WorkflowState[]
  transitions   WorkflowTransition[]
  instances     WorkflowInstance[]

  @@unique([tenantId, id])
  @@unique([tenantId, key, versionNumber])
  @@index([tenantId, status])
  @@map("wf_definitions")
}

model WorkflowState {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  definitionId String             @map("definition_id") @db.Uuid
  position     Int
  key          String
  label        String
  kind         String
  slaHours     Int?               @map("sla_hours")
  priority     String             @default("normal")
  assignee     Json?
  approval     Json?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?            @map("created_by") @db.Uuid
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?            @map("updated_by") @db.Uuid
  version      Int                @default(1)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition   WorkflowDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([definitionId, key])
  @@index([tenantId, definitionId])
  @@map("wf_states")
}

model WorkflowTransition {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  definitionId       String             @map("definition_id") @db.Uuid
  position           Int
  fromState          String             @map("from_state")
  toState            String             @map("to_state")
  action             String
  label              String
  requiredPermission String?            @map("required_permission")
  condition          Json?
  requiresComment    Boolean            @default(false) @map("requires_comment")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?            @map("created_by") @db.Uuid
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?            @map("updated_by") @db.Uuid
  version            Int                @default(1)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition         WorkflowDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([definitionId, fromState, action])
  @@index([tenantId, definitionId])
  @@map("wf_transitions")
}

model WorkflowInstance {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  definitionId String             @map("definition_id") @db.Uuid
  entityType   String             @map("entity_type")
  entityId     String             @map("entity_id") @db.Uuid
  title        String
  currentState String             @map("current_state")
  facts        Json               @default("{}")
  startedBy    String?            @map("started_by") @db.Uuid
  startedAt    DateTime           @map("started_at") @db.Timestamptz(6)
  dueAt        DateTime?          @map("due_at") @db.Timestamptz(6)
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?            @map("created_by") @db.Uuid
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?            @map("updated_by") @db.Uuid
  version      Int                @default(1)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition   WorkflowDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Restrict)
  history      WorkflowHistory[]
  tasks        WorkflowTask[]

  @@unique([tenantId, id])
  @@index([tenantId, definitionId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, startedBy])
  @@map("wf_instances")
}

model WorkflowHistory {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  instanceId String           @map("instance_id") @db.Uuid
  fromState  String?          @map("from_state")
  toState    String           @map("to_state")
  action     String
  actorId    String?          @map("actor_id") @db.Uuid
  onBehalfOf String?          @map("on_behalf_of") @db.Uuid
  comment    String?
  occurredAt DateTime         @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?          @map("created_by") @db.Uuid
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?          @map("updated_by") @db.Uuid
  version    Int              @default(1)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance   WorkflowInstance @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Restrict)
  tasks      WorkflowTask[]

  @@unique([tenantId, id])
  @@index([tenantId, instanceId, occurredAt])
  @@map("wf_history")
}

model WorkflowTask {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  instanceId         String             @map("instance_id") @db.Uuid
  entryId            String             @map("entry_id") @db.Uuid
  stateKey           String             @map("state_key")
  title              String
  kind               String
  sequence           Int                @default(0)
  assigneeId         String?            @map("assignee_id") @db.Uuid
  assigneeRole       String?            @map("assignee_role")
  requiredPermission String?            @map("required_permission")
  priority           String             @default("normal")
  dueAt              DateTime?          @map("due_at") @db.Timestamptz(6)
  status             String             @default("pending")
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(6)
  completedBy        String?            @map("completed_by") @db.Uuid
  delegatedFromId    String?            @map("delegated_from_id") @db.Uuid
  escalatedToId      String?            @map("escalated_to_id") @db.Uuid
  escalatedAt        DateTime?          @map("escalated_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?            @map("created_by") @db.Uuid
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?            @map("updated_by") @db.Uuid
  version            Int                @default(1)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance           WorkflowInstance   @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Restrict)
  entry              WorkflowHistory    @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)
  approvals          WorkflowApproval[]

  @@unique([tenantId, id])
  @@index([tenantId, instanceId])
  @@index([tenantId, entryId])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, assigneeRole, status])
  @@index([tenantId, escalatedToId, status])
  @@index([tenantId, status, dueAt])
  @@map("wf_tasks")
}

model WorkflowApproval {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  taskId     String       @map("task_id") @db.Uuid
  approverId String       @map("approver_id") @db.Uuid
  onBehalfOf String?      @map("on_behalf_of") @db.Uuid
  decision   String
  comment    String?
  decidedAt  DateTime     @map("decided_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?      @map("created_by") @db.Uuid
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?      @map("updated_by") @db.Uuid
  version    Int          @default(1)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  task       WorkflowTask @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, taskId])
  @@map("wf_approvals")
}
