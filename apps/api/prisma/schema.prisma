  purchaseDate     DateTime         @map("purchase_date") @db.Date
  cost             Decimal          @db.Decimal(18, 2)
  usefulLifeMonths Int              @map("useful_life_months")
  /// available, reserved (comodato pendiente de firma), assigned o retired.
  status           String           @default("available")
  location         String?
  retiredOn        DateTime?        @map("retired_on") @db.Date
  retireReason     String?          @map("retire_reason")
  retireNote       String?          @map("retire_note")
  retiredBy        String?          @map("retired_by") @db.Uuid
