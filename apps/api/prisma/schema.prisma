  updatedBy       String?                @map("updated_by") @db.Uuid
  version         Int                    @default(1)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  candidate       HrCandidate?           @relation(fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Restrict)
  contracts       HrContract[]
  onboardingTasks HrOnboardingTask[]
  fileChecklist   HrFileChecklistItem[]
  leaveRequests   HrLeaveRequest[]
  overtime        HrOvertime[]
  novelties       HrPayrollNovelty[]
  reviews         HrPerformanceReview[]
  trainings       HrTrainingAttendance[]
  disciplinary    HrDisciplinaryCase[]
  offboardings    HrOffboarding[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestKey])
  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@map("hr_employees")
}

/// Contrato laboral CT-GTH-001 con firma electrónica: primero el colaborador y luego la empresa.
model HrContract {
  id              String     @id @default(uuid(7)) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  employeeId      String     @map("employee_id") @db.Uuid
  type            String
  startsOn        DateTime   @map("starts_on") @db.Date
  endsOn          DateTime?  @map("ends_on") @db.Date
  salaryBand      String     @map("salary_band")
  /// Información restringida: solo la ven Talento humano, la Dirección y el Contador.
  salary          Decimal    @db.Decimal(18, 2)
  status          String     @default("preparing")
  signBy          DateTime   @map("sign_by") @db.Date
  /// Persona de la Dirección que firma por la empresa.
  companySignerId String     @map("company_signer_id") @db.Uuid
  message         String?
  formRecordId    String?    @map("form_record_id") @db.Uuid
  recordCode      String?    @map("record_code")
  envelopeId      String?    @map("envelope_id") @db.Uuid
  envelopeCode    String?    @map("envelope_code")
  /// El contrato firmado (archivo); obligatorio para vincular.
  documentId      String?    @map("document_id") @db.Uuid
  signedOn        DateTime?  @map("signed_on") @db.Date
  closedReason    String?    @map("closed_reason")
  sentBy          String     @map("sent_by") @db.Uuid
  requestKey      String     @map("request_key")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?    @map("created_by") @db.Uuid
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?    @map("updated_by") @db.Uuid
  version         Int        @default(1)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee        HrEmployee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, requestKey])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("hr_contracts")
}

