// Modelo de datos de ARZA ONE (capítulo 12). Las tablas llevan el prefijo de su dominio y las
// columnas de control del numeral 12.1. La seguridad por fila, los permisos de app_user y los
// disparadores de las columnas de control viven en el SQL de cada migración, porque Prisma no
// los expresa.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Empresas inquilinas (M00). La fila de una empresa solo es visible dentro de su propio contexto.
model Tenant {
  id                      String                   @id @default(uuid(7)) @db.Uuid
  legalName               String                   @map("legal_name")
  tradeName               String?                  @map("trade_name")
  taxId                   String                   @unique @map("tax_id")
  status                  String                   @default("active")
  settings                Json                     @default("{}")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy               String?                  @map("created_by") @db.Uuid
  updatedAt               DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy               String?                  @map("updated_by") @db.Uuid
  version                 Int                      @default(1)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(6)
  outboxEvents            OutboxEvent[]
  users                   User[]
  sessions                Session[]
  tokens                  Token[]
  loginAttempts           LoginAttempt[]
  mfaFactors              MfaFactor[]
  recoveryCodes           RecoveryCode[]
  knownDevices            KnownDevice[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  delegations             Delegation[]
  auditEvents             AuditEvent[]
  auditChainHead          AuditChainHead?
  auditExports            AuditExport[]
  securityEvents          SecurityEvent[]
  sites                   Site[]
  orgUnits                OrgUnit[]
  positions               Position[]
  costCenters             CostCenter[]
  catalogs                Catalog[]
  catalogItems            CatalogItem[]
  sequences               Sequence[]
  parameters              Parameter[]
  holidays                Holiday[]
  parties                 Party[]
  partyRoles              PartyRole[]
  contacts                Contact[]
  bankAccounts            BankAccount[]
  dueDiligence            DueDiligence[]
  files                   File[]
  wfDefinitions           WorkflowDefinition[]
  wfStates                WorkflowState[]
  wfTransitions           WorkflowTransition[]
  wfInstances             WorkflowInstance[]
  wfHistory               WorkflowHistory[]
  wfTasks                 WorkflowTask[]
  wfApprovals             WorkflowApproval[]
  ntfTemplates            NotificationTemplate[]
  notifications           Notification[]
  ntfDeliveries           NotificationDelivery[]
  ntfPreferences          NotificationPreference[]
  comments                Comment[]
  attachments             Attachment[]
  prvNotices              PrivacyNotice[]
  prvConsents             PrivacyConsent[]
  prvActivities           ProcessingActivity[]
  prvProcessors           DataProcessor[]
  prvActivityProcessors   ActivityProcessor[]
  docFolders              DocFolder[]
  docDocuments            DocDocument[]
  docVersions             DocVersion[]
  docLinks                DocLink[]
  docAccessLog            DocAccessLog[]
  docChangeRequests       DocChangeRequest[]
  docAcknowledgements     DocAcknowledgement[]
  docOutputTemplates      DocOutputTemplate[]
  docFormTemplates        DocFormTemplate[]
  docFormRecords          DocFormRecord[]
  docRetentionRules       DocRetentionRule[]
  docDispositionProposals DocDispositionProposal[]
  docDispositions         DocDisposition[]
  docVersionTexts         DocVersionText[]
  crmCampaigns            CrmCampaign[]
  crmLeads                CrmLead[]
  crmOpportunities        CrmOpportunity[]
  crmActivities           CrmActivity[]
  crmServices             CrmService[]
  crmQuotes               CrmQuote[]
  crmQuoteItems           CrmQuoteItem[]
  finTaxParameters        FinTaxParameter[]
  finInvoices             FinInvoice[]
  finInvoiceItems         FinInvoiceItem[]
  finCreditNotes          FinCreditNote[]
  finPayments             FinPayment[]
  finBudgets              FinBudget[]
  finBudgetLines          FinBudgetLine[]
  finExpenses             FinExpense[]
  finPettyCash            FinPettyCash[]
  finBankReconciliations  FinBankReconciliation[]
  finCostCertifications   FinCostCertification[]
  finPeriods              FinPeriod[]
  finExportBatches        FinExportBatch[]
  purRequests             PurRequest[]
  purQuotes               PurQuote[]
  purOrders               PurOrder[]
  purReceipts             PurReceipt[]
  purSupplierEvaluations  PurSupplierEvaluation[]
  purTravelRequests       PurTravelRequest[]
  purTravelExpenses       PurTravelExpense[]
  astAssets               AstAsset[]
  astAssignments          AstAssignment[]
  astMaintenance          AstMaintenance[]
  hrVacancies             HrVacancy[]
  hrCandidates            HrCandidate[]
  hrSelectionEvaluations  HrSelectionEvaluation[]
  hrEmployees             HrEmployee[]
  hrContracts             HrContract[]
  hrOnboardingTasks       HrOnboardingTask[]
  hrFileChecklist         HrFileChecklistItem[]
  hrLeaveRequests         HrLeaveRequest[]
  hrOvertime              HrOvertime[]
  hrPayrollPeriods        HrPayrollPeriod[]
  hrPayrollNovelties      HrPayrollNovelty[]
  hrPerformanceReviews    HrPerformanceReview[]
  hrTrainings             HrTraining[]
  hrTrainingAttendance    HrTrainingAttendance[]
  hrDisciplinaryCases     HrDisciplinaryCase[]
  hrOffboardings          HrOffboarding[]
  ctrClauses              CtrClause[]
  ctrTemplates            CtrTemplate[]
  ctrTemplateClauses      CtrTemplateClause[]
  ctrContracts            CtrContract[]
  ctrContractClauses      CtrContractClause[]
  ctrObligations          CtrObligation[]
  ctrAmendments           CtrAmendment[]
  sigEnvelopes            SigEnvelope[]
  sigSigners              SigSigner[]
  sigEvents               SigEvent[]
  sigVerifications        SigVerification[]
  prjProjects             PrjProject[]
  prjMembers              PrjMember[]
  prjMilestones           PrjMilestone[]
  prjSprints              PrjSprint[]
  prjItems                PrjItem[]
  prjExternalLinks        PrjExternalLink[]
  prjTimeEntries          PrjTimeEntry[]
  prjDeliverables         PrjDeliverable[]
  prjAcceptances          PrjAcceptance[]
  prjRisks                PrjRisk[]
  prjReleases             PrjRelease[]
  prjCodeReviews          PrjCodeReview[]
  prjIncidents            PrjIncident[]
  slaPolicies             SlaPolicy[]
  svcTickets              SvcTicket[]
  svcTicketMessages       SvcTicketMessage[]
  svcWarranties           SvcWarranty[]
  svcCompensations        SvcCompensation[]
  svcPqrsf                SvcPqrsf[]
  svcSurveys              SvcSurvey[]
  svcSurveyResponses      SvcSurveyResponse[]
  svcKbArticles           SvcKbArticle[]
  iamTermsAcceptances     TermsAcceptance[]
  prjClientAccess         PrjClientAccess[]
  prjSharedFiles          PrjSharedFile[]

  @@map("core_tenants")
}

/// Eventos de dominio pendientes de publicar (bandeja de salida, numeral 13.2).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  schemaVersion Int       @default(1) @map("schema_version")
  payload       Json
  actorId       String?   @map("actor_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@map("core_outbox_events")
}

/// Cuentas de usuario (M01). El correo es único en toda la plataforma: con él se sabe a qué
/// empresa pertenece la persona al iniciar sesión.
model User {
  id                  String         @id @default(uuid(7)) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  email               String         @unique
  displayName         String?        @map("display_name")
  passwordHash        String?        @map("password_hash")
  kind                String
  status              String         @default("invited")
  partyId             String?        @map("party_id") @db.Uuid
  photoFileId         String?        @map("photo_file_id") @db.Uuid
  positionId          String?        @map("position_id") @db.Uuid
  mfaRequired         Boolean        @default(true) @map("mfa_required")
  lastLoginAt         DateTime?      @map("last_login_at") @db.Timestamptz(6)
  lockedUntil         DateTime?      @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt   DateTime?      @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?        @map("created_by") @db.Uuid
  updatedAt           DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?        @map("updated_by") @db.Uuid
  version             Int            @default(1)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions            Session[]
  tokens              Token[]
  loginAttempts       LoginAttempt[]
  mfaFactors          MfaFactor[]
  recoveryCodes       RecoveryCode[]
  knownDevices        KnownDevice[]
  roleAssignments     UserRole[]
  delegationsGiven    Delegation[]   @relation("DelegationsGiven")
  delegationsReceived Delegation[]   @relation("DelegationsReceived")
  position            Position?      @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, positionId])
  @@index([tenantId, partyId])
  @@map("iam_users")
}

/// Sesiones (numeral 15.1). Solo se guarda la huella SHA-256 de la llave de la cookie. Una sesión
/// sin authenticated_at solo verificó la contraseña: le falta el segundo factor (B09).
model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash")
  ip                String?
  userAgent         String?      @map("user_agent")
  deviceId          String?      @map("device_id") @db.Uuid
  authenticatedAt   DateTime?    @map("authenticated_at") @db.Timestamptz(6)
  reauthenticatedAt DateTime?    @map("reauthenticated_at") @db.Timestamptz(6)
  lastSeenAt        DateTime     @map("last_seen_at") @db.Timestamptz(6)
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?      @map("revoked_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?      @map("created_by") @db.Uuid
  updatedAt         DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?      @map("updated_by") @db.Uuid
  version           Int          @default(1)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  device            KnownDevice? @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, deviceId])
  @@map("iam_sessions")
}

/// Segundo factor TOTP (B09). Una fila por persona y tipo. El secreto se guarda cifrado con
/// FIELD_ENCRYPTION_KEY (capítulo 12.1); mientras se configura, el nuevo espera en pending_*.
model MfaFactor {
  id                     String    @id @default(uuid(7)) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  type                   String    @default("totp")
  secretEncrypted        String?   @map("secret_encrypted")
  confirmedAt            DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedStep           Int?      @map("last_used_step")
  pendingSecretEncrypted String?   @map("pending_secret_encrypted")
  pendingExpiresAt       DateTime? @map("pending_expires_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?   @map("updated_by") @db.Uuid
  version                Int       @default(1)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                   User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, userId, type])
  @@map("iam_mfa_factors")
}

/// Códigos de recuperación del segundo factor (B09): diez, de un solo uso. Solo su huella.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@map("iam_recovery_codes")
}

/// Equipos desde los que una persona ya entró (B09), para avisar de un dispositivo nuevo
/// (numeral 15.5). Solo la huella de la marca aleatoria que guarda el navegador.
model KnownDevice {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceHash  String    @map("device_hash")
  userAgent   String?   @map("user_agent")
  firstSeenAt DateTime  @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  sessions    Session[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId, deviceHash])
  @@map("iam_known_devices")
}

/// Enlaces de un solo uso: invitación y recuperación de contraseña. Solo se guarda su huella.
model Token {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId, purpose])
  @@map("iam_tokens")
}

/// Intentos de inicio de sesión. tenant_id queda vacío cuando el correo no tiene cuenta: esas
/// filas solo las leen y escriben las funciones de inicio de sesión de la migración.
model LoginAttempt {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  email      String
  ip         String?
  succeeded  Boolean
  reason     String
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User?     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([email, occurredAt])
  @@index([tenantId, userId])
  @@map("iam_login_attempts")
}

/// Catálogo de permisos del anexo G (B10). Es el mismo para todas las empresas: no lleva
/// tenant_id. Lo carga la semilla desde packages/contracts; la API solo lo lee.
model Permission {
  id              String           @id @default(uuid(7)) @db.Uuid
  code            String           @unique
  resource        String
  action          String
  groupKey        String           @map("group_key")
  level           String
  ownable         Boolean
  description     String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?          @map("updated_by") @db.Uuid
  version         Int              @default(1)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("iam_permissions")
}

/// Roles de cada empresa (numeral 15.2): los 16 del sistema, que no se editan, y los
/// personalizados. Nunca se borran.
model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean          @map("is_system")
  audience    String
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?          @map("created_by") @db.Uuid
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?          @map("updated_by") @db.Uuid
  version     Int              @default(1)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("iam_roles")
}

/// Permisos de cada rol. conditions vacío es «todo»; {"scope": "own"} es «solo lo propio»
/// (letra P). Un permiso retirado de un rol personalizado queda con deleted_at.
model RolePermission {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  conditions   Json?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?    @map("updated_by") @db.Uuid
  version      Int        @default(1)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([tenantId, roleId])
  @@map("iam_role_permissions")
}

/// Roles de cada persona, con vigencia (ficha 17.2). Retirar un rol deja revoked_at: el
/// historial completo queda. Nadie se asigna un rol a sí mismo (assigned_by distinto de user_id).
model UserRole {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  scopeType  String?   @map("scope_type")
  scopeId    String?   @map("scope_id") @db.Uuid
  validFrom  DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  assignedBy String?   @map("assigned_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  role       Role      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("iam_user_roles")
}

/// Delegación temporal de aprobaciones (ficha 17.2): quien delega, a quién, desde, hasta y qué
/// permisos de aprobación (scope, lista de códigos). Retirarla deja revoked_at.
model Delegation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime  @map("ends_at") @db.Timestamptz(6)
  scope      Json
  reason     String
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromUser   User      @relation("DelegationsGiven", fields: [tenantId, fromUserId], references: [tenantId, id], onDelete: Restrict)
  toUser     User      @relation("DelegationsReceived", fields: [tenantId, toUserId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, fromUserId])
  @@index([tenantId, toUserId])
  @@map("iam_delegations")
}

/// Auditoría de negocio (M19), solo inserción, particionada por mes de occurred_at (ADR-012).
/// La base de datos fija seq, prev_hash y hash al insertar: lo que envíe la API se ignora.
model AuditEvent {
  id            String   @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// Posición en la cadena de la empresa: 1, 2, 3… sin saltos.
  seq           BigInt   @default(0)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  actorId       String?  @map("actor_id") @db.Uuid
  actorKind     String   @map("actor_kind")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  result        String
  changes       Json     @default("{}")
  ip            String?
  correlationId String?  @map("correlation_id")
  prevHash      String   @default("") @map("prev_hash")
  hash          String   @default("")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // En una tabla particionada la llave primaria debe incluir la columna de la partición.
  @@id([id, occurredAt])
  @@index([tenantId, seq])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@map("aud_events")
}

/// Último eslabón de la cadena de cada empresa. Solo lo escribe el disparador de aud_events; al
/// compararlo con la última fila se detecta que alguien borró los eventos más recientes.
model AuditChainHead {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  seq       BigInt
  hash      String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("aud_chain_heads")
}

/// Exportaciones de la auditoría (numeral 13.2), solo inserción. file_id queda vacío hasta que
/// exista el servicio de archivos (B14): hoy la exportación se descarga en el acto.
model AuditExport {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  requestedBy String   @map("requested_by") @db.Uuid
  scope       Json
  rowCount    Int      @map("row_count")
  fileId      String?  @map("file_id") @db.Uuid
  exportedAt  DateTime @map("exported_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, exportedAt])
  @@map("aud_exports")
}

/// Eventos de seguridad (M19), solo inserción: bloqueos de cuenta y alertas.
model SecurityEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  type       String
  userId     String?  @map("user_id") @db.Uuid
  ip         String?
  detail     Json     @default("{}")
  severity   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@map("aud_security_events")
}

/// Sedes de la empresa (M00). Solo una es la principal: la API lo garantiza al guardar.
model Site {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  city      String
  address   String
  isMain    Boolean   @default(false) @map("is_main")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("core_sites")
}

/// Procesos y áreas del mapa de procesos (MP-DG-001), con su jerarquía. Uno con registros
/// asociados no se elimina: se inactiva (ficha 17.1).
model OrgUnit {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  parentId        String?      @map("parent_id") @db.Uuid
  code            String
  name            String
  kind            String
  ownerPositionId String?      @map("owner_position_id") @db.Uuid
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?      @map("created_by") @db.Uuid
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?      @map("updated_by") @db.Uuid
  version         Int          @default(1)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent          OrgUnit?     @relation("OrgUnitTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children        OrgUnit[]    @relation("OrgUnitTree")
  ownerPosition   Position?    @relation("OrgUnitOwner", fields: [tenantId, ownerPositionId], references: [tenantId, id], onDelete: Restrict)
  positions       Position[]   @relation("PositionUnit")
  costCenters     CostCenter[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, ownerPositionId])
  @@map("core_org_units")
}

/// Cargos del organigrama (DC-SGC-001): a qué proceso pertenecen y a qué cargo reportan.
model Position {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  orgUnitId    String     @map("org_unit_id") @db.Uuid
  name         String
  reportsToId  String?    @map("reports_to_id") @db.Uuid
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?    @map("updated_by") @db.Uuid
  version      Int        @default(1)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit      OrgUnit    @relation("PositionUnit", fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)
  reportsTo    Position?  @relation("PositionTree", fields: [tenantId, reportsToId], references: [tenantId, id], onDelete: Restrict)
  subordinates Position[] @relation("PositionTree")
  ledUnits     OrgUnit[]  @relation("OrgUnitOwner")
  users        User[]

  @@unique([tenantId, id])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, reportsToId])
  @@map("core_positions")
}

/// Centros de costo, opcionalmente ligados a un proceso o área.
model CostCenter {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  orgUnitId String?   @map("org_unit_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit   OrgUnit?  @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, orgUnitId])
  @@map("core_cost_centers")
}

/// Catálogos administrables: la lista la define el sistema, sus opciones la empresa.
model Catalog {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?       @map("updated_by") @db.Uuid
  version     Int           @default(1)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items       CatalogItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("core_catalogs")
}

/// Opciones de un catálogo. Una opción que ya se usó no se borra: se inactiva.
model CatalogItem {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  catalogId String    @map("catalog_id") @db.Uuid
  code      String
  label     String
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  catalog   Catalog   @relation(fields: [tenantId, catalogId], references: [tenantId, id], onDelete: Restrict)

  @@unique([catalogId, code])
  @@index([tenantId, catalogId])
  @@map("core_catalog_items")
}

/// Consecutivos de negocio por tipo y año (ADR-021). next_value solo lo sube el servicio de
/// consecutivos, con la fila bloqueada: sin saltos ni duplicados. Los consecutivos sin año (B18,
/// como PR-SGC-001) llevan yearly falso y el año 0, y los crea el módulo que los usa.
model Sequence {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  name      String
  prefix    String
  year      Int
  yearly    Boolean   @default(true)
  nextValue Int       @default(1) @map("next_value")
  padding   Int       @default(4)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key, year])
  @@map("core_sequences")
}

/// Parámetros con vigencia (ficha 17.1): nunca se sobrescriben. Una vigencia nueva cierra la
/// anterior el día antes de empezar (valid_to) y la conserva.
model Parameter {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  value     Json
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key, validFrom])
  @@map("core_parameters")
}

/// Festivos para el cálculo de días hábiles. Uno retirado queda con deleted_at y se recupera si
/// se vuelve a agregar la misma fecha.
model Holiday {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  holidayDate DateTime  @map("holiday_date") @db.Date
  name        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, holidayDate])
  @@map("core_holidays")
}

/// Terceros (M02): registro único de cada persona u organización con la que la empresa se
/// relaciona. Un duplicado fusionado queda con merged_into_id y deleted_at; nunca se borra.
model Party {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  kind              String
  legalName         String?        @map("legal_name")
  tradeName         String?        @map("trade_name")
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  idType            String?        @map("id_type")
  idNumber          String?        @map("id_number")
  checkDigit        Int?           @map("check_digit") @db.SmallInt
  email             String?
  phone             String?
  city              String?
  address           String?
  status            String         @default("active")
  statusReason      String?        @map("status_reason")
  /// Sin uso desde B17 (la autorización vive en prv_consents); se conservan para la versión
  /// anterior durante el despliegue. shortcut: borrarlas en una migración con arza:contract.
  dataPurpose       String?        @map("data_purpose")
  dataAuthorization String?        @map("data_authorization")
  dataAuthorizedOn  DateTime?      @map("data_authorized_on") @db.Date
  mergedIntoId      String?        @map("merged_into_id") @db.Uuid
  logoFileId        String?        @map("logo_file_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?        @map("created_by") @db.Uuid
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?        @map("updated_by") @db.Uuid
  version           Int            @default(1)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mergedInto        Party?         @relation("PartyMerges", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict)
  mergedParties     Party[]        @relation("PartyMerges")
  roles             PartyRole[]
  contacts          Contact[]      @relation("OrganizationContacts")
  contactOf         Contact[]      @relation("PersonContacts")
  bankAccounts      BankAccount[]
  dueDiligence      DueDiligence[]

  @@unique([tenantId, id])
  @@unique([tenantId, idType, idNumber])
  @@index([tenantId, mergedIntoId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("pty_parties")
}

/// Papeles del tercero: cliente, proveedor, colaborador, contacto o candidato. Uno por papel; al
/// terminar queda inactivo y la auditoría guarda el historial.
model PartyRole {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  partyId   String    @map("party_id") @db.Uuid
  role      String
  since     DateTime  @db.Date
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party     Party     @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, partyId, role])
  @@map("pty_party_roles")
}

/// Personas de contacto de una organización, con su cargo y si firman por ella.
model Contact {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  jobTitle       String?   @map("job_title")
  isPrimary      Boolean   @default(false) @map("is_primary")
  canSign        Boolean   @default(false) @map("can_sign")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization   Party     @relation("OrganizationContacts", fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  person         Party     @relation("PersonContacts", fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, organizationId, personId])
  @@index([tenantId, personId])
  @@map("pty_contacts")
}

/// Cuentas para pagos. El número va cifrado (numeral 12.1); en claro solo los cuatro últimos
/// dígitos. La aprueba una persona distinta de quien la registró (ficha 17.3).
model BankAccount {
  id                     String        @id @default(uuid(7)) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  partyId                String        @map("party_id") @db.Uuid
  bank                   String
  accountType            String        @map("account_type")
  accountNumberEncrypted String        @map("account_number_encrypted")
  accountLast4           String        @map("account_last4")
  status                 String        @default("pending")
  replacesId             String?       @map("replaces_id") @db.Uuid
  reviewedBy             String?       @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote             String?       @map("review_note")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?       @map("created_by") @db.Uuid
  updatedAt              DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?       @map("updated_by") @db.Uuid
  version                Int           @default(1)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(6)
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party                  Party         @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict)
  replaces               BankAccount?  @relation("BankAccountReplacements", fields: [tenantId, replacesId], references: [tenantId, id], onDelete: Restrict)
  replacedBy             BankAccount[] @relation("BankAccountReplacements")

  @@unique([tenantId, id])
  @@index([tenantId, partyId])
  @@index([tenantId, replacesId])
  @@map("pty_bank_accounts")
}

/// Conocimiento del tercero y nivel de riesgo. Lo aprueba una persona distinta de quien lo
/// registró; sin uno aprobado y vigente no se factura ni se contrata (ficha 17.3).
model DueDiligence {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  partyId      String    @map("party_id") @db.Uuid
  riskLevel    String    @map("risk_level")
  summary      String
  status       String    @default("pending")
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?   @map("review_note")
  nextReviewOn DateTime? @map("next_review_on") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party        Party     @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, partyId])
  @@map("pty_due_diligence")
}

/// Archivo físico guardado en el almacenamiento privado (M03, B14). Entra «esperando el archivo»;
/// el worker lo analiza con el antivirus, revisa que su contenido sea del tipo declarado y calcula
/// su huella SHA-256. Solo un archivo disponible se descarga (numeral 13.2, ADR-013).
model File {
  id            String                   @id @default(uuid(7)) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  storageKey    String                   @map("storage_key")
  fileName      String                   @map("file_name")
  mimeType      String                   @map("mime_type")
  sizeBytes     Int                      @map("size_bytes")
  sha256        String?
  scanStatus    String                   @default("pending_upload") @map("scan_status")
  rejection     String?
  scannedAt     DateTime?                @map("scanned_at") @db.Timestamptz(6)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?                  @map("created_by") @db.Uuid
  updatedAt     DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?                  @map("updated_by") @db.Uuid
  version       Int                      @default(1)
  deletedAt     DateTime?                @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceOf      DocVersion[]             @relation("VersionSource")
  renderOf      DocVersion[]             @relation("VersionPdf")
  copyOf        DocVersion[]             @relation("VersionCopy")
  templateOf    DocOutputTemplate[]
  recordPdfOf   DocFormRecord[]
  certificateOf DocDispositionProposal[]

  @@unique([tenantId, id])
  @@unique([storageKey])
  @@index([tenantId, createdBy, createdAt])
  @@map("doc_files")
}

/// Carpetas y expedientes (B18, ficha 17.4). Un expediente es la carpeta de un registro de otro
/// módulo, por ahora de un tercero; se guarda por identificador, sin relación con sus tablas.
model DocFolder {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  code           String?
  name           String
  kind           String        @default("folder")
  entityType     String?       @map("entity_type")
  entityId       String?       @map("entity_id") @db.Uuid
  classification String        @default("internal")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?       @map("updated_by") @db.Uuid
  version        Int           @default(1)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent         DocFolder?    @relation("FolderTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children       DocFolder[]   @relation("FolderTree")
  documents      DocDocument[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, parentId])
  @@map("doc_folders")
}

/// Documento lógico (B18, ficha 17.4): código PR-SGC-001, datos de la versión vigente y su estado.
/// El proceso y el cargo responsable son del núcleo y se guardan por identificador.
model DocDocument {
  id               String               @id @default(uuid(7)) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  folderId         String               @map("folder_id") @db.Uuid
  code             String
  title            String
  docType          String               @map("doc_type")
  processId        String?              @map("process_id") @db.Uuid
  classification   String
  status           String               @default("draft")
  currentVersionId String?              @map("current_version_id") @db.Uuid
  ownerPositionId  String?              @map("owner_position_id") @db.Uuid
  isControlled     Boolean              @map("is_controlled")
  /// Regla de retención propia del documento (B21): una excepción a la de su tipo y proceso.
  retentionRuleId  String?              @map("retention_rule_id") @db.Uuid
  /// Cuándo se eliminó su contenido por disposición final (B21); el estado es `disposed`.
  disposedAt       DateTime?            @map("disposed_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?              @map("created_by") @db.Uuid
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?              @map("updated_by") @db.Uuid
  version          Int                  @default(1)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  folder           DocFolder            @relation(fields: [tenantId, folderId], references: [tenantId, id], onDelete: Restrict)
  versions         DocVersion[]
  links            DocLink[]
  accessLog        DocAccessLog[]
  changeRequests   DocChangeRequest[]
  acknowledgements DocAcknowledgement[]
  formTemplates    DocFormTemplate[]
  retentionRule    DocRetentionRule?    @relation(fields: [tenantId, retentionRuleId], references: [tenantId, id], onDelete: Restrict)
  dispositions     DocDisposition[]
  texts            DocVersionText[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, folderId])
  @@index([tenantId, processId])
  @@index([tenantId, retentionRuleId])
  @@map("doc_documents")
}

/// Versión de un documento (B18, ficha 17.4): borrador → en revisión → aprobada → vigente →
/// obsoleta. Lleva el archivo fuente, su PDF y los datos que el documento toma al publicarla. Una
/// sola vigente por documento; fuera del borrador, la base de datos no deja cambiar su contenido.
model DocVersion {
  id                 String               @id @default(uuid(7)) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  documentId         String               @map("document_id") @db.Uuid
  number             Int
  versionLabel       String               @map("version_label")
  status             String               @default("draft")
  sourceFileId       String               @map("source_file_id") @db.Uuid
  pdfFileId          String?              @map("pdf_file_id") @db.Uuid
  renderStatus       String               @default("pending") @map("render_status")
  title              String
  classification     String
  ownerPositionId    String?              @map("owner_position_id") @db.Uuid
  changeSummary      String               @map("change_summary")
  reviewNote         String?              @map("review_note")
  submittedAt        DateTime?            @map("submitted_at") @db.Timestamptz(6)
  approvedBy         String?              @map("approved_by") @db.Uuid
  approvedAt         DateTime?            @map("approved_at") @db.Timestamptz(6)
  effectiveDate      DateTime?            @map("effective_date") @db.Date
  publishedAt        DateTime?            @map("published_at") @db.Timestamptz(6)
  obsoletedAt        DateTime?            @map("obsoleted_at") @db.Timestamptz(6)
  /// platform: elaborada en ARZA ONE; import: carga inicial del Listado Maestro (B19).
  origin             String               @default("platform")
  /// Solicitud de Acción Documental que la originó (B19).
  changeRequestId    String?              @map("change_request_id") @db.Uuid
  /// Trámite de revisión, aprobación y publicación en el motor de flujos (B19).
  workflowInstanceId String?              @map("workflow_instance_id") @db.Uuid
  /// Copia de consulta de la versión vigente: su PDF con el pie de copia no controlada (B20).
  copyFileId         String?              @map("copy_file_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?              @map("created_by") @db.Uuid
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?              @map("updated_by") @db.Uuid
  version            Int                  @default(1)
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document           DocDocument          @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  sourceFile         File                 @relation("VersionSource", fields: [tenantId, sourceFileId], references: [tenantId, id], onDelete: Restrict)
  pdfFile            File?                @relation("VersionPdf", fields: [tenantId, pdfFileId], references: [tenantId, id], onDelete: Restrict)
  copyFile           File?                @relation("VersionCopy", fields: [tenantId, copyFileId], references: [tenantId, id], onDelete: Restrict)
  changeRequest      DocChangeRequest?    @relation(fields: [tenantId, changeRequestId], references: [tenantId, id], onDelete: Restrict)
  accessLog          DocAccessLog[]
  acknowledgements   DocAcknowledgement[]
  text               DocVersionText?

  @@unique([tenantId, id])
  @@unique([tenantId, documentId, number])
  @@unique([tenantId, changeRequestId])
  @@unique([tenantId, workflowInstanceId])
  @@index([tenantId, documentId, status])
  @@map("doc_versions")
}

/// Solicitud de Acción Documental (B19, FT-SGC-001): pedir crear, modificar o eliminar un documento
/// del SGC. Radicada → en análisis → aprobada o rechazada → ejecutada. El trámite lo lleva el motor
/// de flujos; quien la pide nunca la decide.
model DocChangeRequest {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  code               String
  action             String
  documentId         String?      @map("document_id") @db.Uuid
  docType            String?      @map("doc_type")
  processId          String?      @map("process_id") @db.Uuid
  title              String
  justification      String
  status             String       @default("filed")
  requestedBy        String       @map("requested_by") @db.Uuid
  workflowInstanceId String?      @map("workflow_instance_id") @db.Uuid
  decidedBy          String?      @map("decided_by") @db.Uuid
  decidedAt          DateTime?    @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?      @map("decision_note")
  executedAt         DateTime?    @map("executed_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?      @map("created_by") @db.Uuid
  updatedAt          DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?      @map("updated_by") @db.Uuid
  version            Int          @default(1)
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document           DocDocument? @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  versions           DocVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, workflowInstanceId])
  @@index([tenantId, status])
  @@index([tenantId, documentId])
  @@index([tenantId, requestedBy])
  @@map("doc_change_requests")
}

/// Constancia de lectura (B19, ficha 17.4): al publicar, una fila pendiente por cada persona de los
/// cargos destinatarios; queda confirmada cuando la persona declara que leyó la versión vigente.
model DocAcknowledgement {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  documentId     String      @map("document_id") @db.Uuid
  versionId      String      @map("version_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  positionId     String?     @map("position_id") @db.Uuid
  requestedAt    DateTime?   @map("requested_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?   @map("acknowledged_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?     @map("created_by") @db.Uuid
  updatedAt      DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?     @map("updated_by") @db.Uuid
  version        Int         @default(1)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document       DocDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  docVersion     DocVersion  @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, versionId, userId])
  @@index([tenantId, userId, acknowledgedAt])
  @@map("doc_acknowledgements")
}

/// Vínculo de un documento con un registro de otro módulo (B18): un cargo, un proceso o un tercero.
model DocLink {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  documentId String      @map("document_id") @db.Uuid
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  relation   String
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?     @map("created_by") @db.Uuid
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?     @map("updated_by") @db.Uuid
  version    Int         @default(1)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document   DocDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, documentId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
  @@map("doc_links")
}

/// Consultas y descargas de documentos confidenciales y restringidos (B18, numeral 15.4). Solo se
/// agregan filas: nadie las cambia ni las borra.
model DocAccessLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  documentId String      @map("document_id") @db.Uuid
  versionId  String?     @map("version_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  action     String
  occurredAt DateTime    @map("occurred_at") @db.Timestamptz(6)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document   DocDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  docVersion DocVersion? @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, documentId, occurredAt])
  @@map("doc_access_log")
}

/// Plantilla de salida (B20, numeral 13.2): HTML con variables {{nombre}} o Word con variables
/// {nombre}. Cada publicación es una versión; publicada, no cambia.
model DocOutputTemplate {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  code          String
  name          String
  /// html o docx.
  engine        String
  outputVersion Int               @map("output_version")
  status        String            @default("draft")
  body          String?
  fileId        String?           @map("file_id") @db.Uuid
  variables     Json              @default("[]")
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(6)
  publishedBy   String?           @map("published_by") @db.Uuid
  retiredAt     DateTime?         @map("retired_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?           @map("created_by") @db.Uuid
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?           @map("updated_by") @db.Uuid
  version       Int               @default(1)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  file          File?             @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict)
  formTemplates DocFormTemplate[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, outputVersion])
  @@index([tenantId, status])
  @@map("doc_output_templates")
}

/// Formato digital (B20, ficha 17.4 y capítulo 18, forma B): una fila por versión de cada formato.
/// Sus campos van en «schema» (jsonb validado contra formDefinitionSchema). Publicada, no cambia;
/// solo pasa a retirada cuando se publica la siguiente.
model DocFormTemplate {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  code             String
  name             String
  formVersion      Int                @map("form_version")
  status           String             @default("draft")
  /// manual: lo diligencia una persona; system: lo llena la plataforma (FT-SGC-001).
  fillMode         String             @default("manual") @map("fill_mode")
  definition       Json               @map("schema")
  layout           Json               @default("{}")
  documentId       String?            @map("document_id") @db.Uuid
  outputTemplateId String?            @map("output_template_id") @db.Uuid
  /// Flujo de aprobación de los registros; null: el registro termina al enviarlo.
  workflowKey      String?            @map("workflow_key")
  classification   String             @default("internal")
  entityType       String?            @map("entity_type")
  publishedAt      DateTime?          @map("published_at") @db.Timestamptz(6)
  publishedBy      String?            @map("published_by") @db.Uuid
  retiredAt        DateTime?          @map("retired_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?            @map("created_by") @db.Uuid
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?            @map("updated_by") @db.Uuid
  version          Int                @default(1)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document         DocDocument?       @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  outputTemplate   DocOutputTemplate? @relation(fields: [tenantId, outputTemplateId], references: [tenantId, id], onDelete: Restrict)
  records          DocFormRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, formVersion])
  @@unique([tenantId, id, formVersion])
  @@index([tenantId, status])
  @@map("doc_form_templates")
}

/// Registro diligenciado de un formato (B20): guarda para siempre la versión del formato con que se
/// creó (template_id y template_version, que la base de datos amarra a esa misma versión) y los
/// datos usados para su PDF. Borrador → en aprobación → terminado.
model DocFormRecord {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  templateId         String          @map("template_id") @db.Uuid
  templateVersion    Int             @map("template_version")
  code               String
  data               Json            @default("{}")
  status             String          @default("draft")
  classification     String          @default("internal")
  entityType         String?         @map("entity_type")
  entityId           String?         @map("entity_id") @db.Uuid
  workflowInstanceId String?         @map("workflow_instance_id") @db.Uuid
  submittedAt        DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approvedBy         String?         @map("approved_by") @db.Uuid
  approvedAt         DateTime?       @map("approved_at") @db.Timestamptz(6)
  returnNote         String?         @map("return_note")
  completedAt        DateTime?       @map("completed_at") @db.Timestamptz(6)
  /// none: sin terminar; pending, ready o failed: generación del PDF.
  renderStatus       String          @default("none") @map("render_status")
  pdfFileId          String?         @map("pdf_file_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?         @map("created_by") @db.Uuid
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?         @map("updated_by") @db.Uuid
  version            Int             @default(1)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template           DocFormTemplate @relation(fields: [tenantId, templateId, templateVersion], references: [tenantId, id, formVersion], onDelete: Restrict)
  pdfFile            File?           @relation(fields: [tenantId, pdfFileId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, workflowInstanceId])
  @@index([tenantId, templateId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdBy])
  @@index([tenantId, renderStatus])
  @@map("doc_form_records")
}

/// Regla de retención (B21, RE-SGC-005): una serie documental con sus años en el archivo de gestión
/// y en el central y su disposición final. Se aplica a los documentos de su tipo, de su proceso o de
/// los dos (la más específica gana); un documento puede llevar otra como excepción.
model DocRetentionRule {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  code         String
  name         String
  docType      String?          @map("doc_type")
  processId    String?          @map("process_id") @db.Uuid
  activeYears  Int              @map("active_years")
  archiveYears Int              @map("archive_years")
  disposition  String
  legalBasis   String           @map("legal_basis")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?          @map("created_by") @db.Uuid
  updatedAt    DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?          @map("updated_by") @db.Uuid
  version      Int              @default(1)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents    DocDocument[]
  dispositions DocDisposition[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, docType])
  @@index([tenantId, processId])
  @@map("doc_retention_rules")
}

/// Propuesta mensual de disposición final (B21): los documentos con la retención vencida. Calidad
/// la revisa y la envía, otra persona la aprueba o la rechaza, y el worker ejecuta la aprobada y
/// genera el acta. En revisión → en aprobación → aprobada o rechazada → ejecutada.
model DocDispositionProposal {
  id                 String           @id @default(uuid(7)) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  code               String
  period             DateTime         @db.Date
  status             String           @default("review")
  workflowInstanceId String?          @map("workflow_instance_id") @db.Uuid
  sentBy             String?          @map("sent_by") @db.Uuid
  sentAt             DateTime?        @map("sent_at") @db.Timestamptz(6)
  decidedBy          String?          @map("decided_by") @db.Uuid
  decidedAt          DateTime?        @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?          @map("decision_note")
  executedAt         DateTime?        @map("executed_at") @db.Timestamptz(6)
  /// El acta de disposición en PDF.
  certificateFileId  String?          @map("certificate_file_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?          @map("created_by") @db.Uuid
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?          @map("updated_by") @db.Uuid
  version            Int              @default(1)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  certificateFile    File?            @relation(fields: [tenantId, certificateFileId], references: [tenantId, id], onDelete: Restrict)
  items              DocDisposition[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, period])
  @@unique([tenantId, workflowInstanceId])
  @@index([tenantId, status])
  @@map("doc_disposition_proposals")
}

/// Un documento de una propuesta de disposición (B21): eliminarlo, como dice su regla, o
/// conservarlo para siempre por decisión de Calidad, con su motivo.
model DocDisposition {
  id              String                 @id @default(uuid(7)) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  proposalId      String                 @map("proposal_id") @db.Uuid
  documentId      String                 @map("document_id") @db.Uuid
  retentionRuleId String                 @map("retention_rule_id") @db.Uuid
  dueOn           DateTime               @map("due_on") @db.Date
  action          String                 @default("destroy")
  keepReason      String?                @map("keep_reason")
  executedBy      String?                @map("executed_by") @db.Uuid
  executedAt      DateTime?              @map("executed_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?                @map("created_by") @db.Uuid
  updatedAt       DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?                @map("updated_by") @db.Uuid
  version         Int                    @default(1)
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  proposal        DocDispositionProposal @relation(fields: [tenantId, proposalId], references: [tenantId, id], onDelete: Restrict)
  document        DocDocument            @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  retentionRule   DocRetentionRule       @relation(fields: [tenantId, retentionRuleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, proposalId, documentId])
  @@index([tenantId, documentId])
  @@map("doc_dispositions")
}

/// Texto de una versión para la búsqueda de texto completo (B21, numeral 13.2): el worker lo saca de
/// su PDF. La base de datos lo indexa en español y sin tildes (doc_version_texts_search_idx).
model DocVersionText {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  documentId String      @map("document_id") @db.Uuid
  versionId  String      @map("version_id") @db.Uuid
  status     String
  content    String
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?     @map("created_by") @db.Uuid
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?     @map("updated_by") @db.Uuid
  version    Int         @default(1)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document   DocDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  versionRow DocVersion  @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, versionId])
  @@index([tenantId, documentId])
  @@map("doc_version_texts")
}

// M04 Flujos y tareas (B15, ADR-011). Las personas se guardan por identificador, sin relación con
// las tablas de identidad: el motor las consulta por el índice del módulo iam.

model WorkflowDefinition {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  key           String
  versionNumber Int                  @map("version_number")
  name          String
  description   String?
  entityType    String               @map("entity_type")
  status        String               @default("draft")
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(6)
  publishedBy   String?              @map("published_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?              @map("created_by") @db.Uuid
  updatedAt     DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?              @map("updated_by") @db.Uuid
  version       Int                  @default(1)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  states        WorkflowState[]
  transitions   WorkflowTransition[]
  instances     WorkflowInstance[]

  @@unique([tenantId, id])
  @@unique([tenantId, key, versionNumber])
  @@index([tenantId, status])
  @@map("wf_definitions")
}

model WorkflowState {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  definitionId String             @map("definition_id") @db.Uuid
  position     Int
  key          String
  label        String
  kind         String
  slaHours     Int?               @map("sla_hours")
  priority     String             @default("normal")
  assignee     Json?
  approval     Json?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?            @map("created_by") @db.Uuid
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?            @map("updated_by") @db.Uuid
  version      Int                @default(1)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition   WorkflowDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([definitionId, key])
  @@index([tenantId, definitionId])
  @@map("wf_states")
}

model WorkflowTransition {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  definitionId       String             @map("definition_id") @db.Uuid
  position           Int
  fromState          String             @map("from_state")
  toState            String             @map("to_state")
  action             String
  label              String
  requiredPermission String?            @map("required_permission")
  condition          Json?
  requiresComment    Boolean            @default(false) @map("requires_comment")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?            @map("created_by") @db.Uuid
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?            @map("updated_by") @db.Uuid
  version            Int                @default(1)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition         WorkflowDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([definitionId, fromState, action])
  @@index([tenantId, definitionId])
  @@map("wf_transitions")
}

model WorkflowInstance {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  definitionId String             @map("definition_id") @db.Uuid
  entityType   String             @map("entity_type")
  entityId     String             @map("entity_id") @db.Uuid
  title        String
  currentState String             @map("current_state")
  facts        Json               @default("{}")
  startedBy    String?            @map("started_by") @db.Uuid
  startedAt    DateTime           @map("started_at") @db.Timestamptz(6)
  dueAt        DateTime?          @map("due_at") @db.Timestamptz(6)
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?            @map("created_by") @db.Uuid
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?            @map("updated_by") @db.Uuid
  version      Int                @default(1)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition   WorkflowDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Restrict)
  history      WorkflowHistory[]
  tasks        WorkflowTask[]

  @@unique([tenantId, id])
  @@index([tenantId, definitionId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, startedBy])
  @@map("wf_instances")
}

model WorkflowHistory {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  instanceId String           @map("instance_id") @db.Uuid
  fromState  String?          @map("from_state")
  toState    String           @map("to_state")
  action     String
  actorId    String?          @map("actor_id") @db.Uuid
  onBehalfOf String?          @map("on_behalf_of") @db.Uuid
  comment    String?
  occurredAt DateTime         @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?          @map("created_by") @db.Uuid
  updatedAt  DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?          @map("updated_by") @db.Uuid
  version    Int              @default(1)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance   WorkflowInstance @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Restrict)
  tasks      WorkflowTask[]

  @@unique([tenantId, id])
  @@index([tenantId, instanceId, occurredAt])
  @@map("wf_history")
}

model WorkflowTask {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  instanceId         String             @map("instance_id") @db.Uuid
  entryId            String             @map("entry_id") @db.Uuid
  stateKey           String             @map("state_key")
  title              String
  kind               String
  sequence           Int                @default(0)
  assigneeId         String?            @map("assignee_id") @db.Uuid
  assigneeRole       String?            @map("assignee_role")
  requiredPermission String?            @map("required_permission")
  priority           String             @default("normal")
  dueAt              DateTime?          @map("due_at") @db.Timestamptz(6)
  status             String             @default("pending")
  startedAt          DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(6)
  completedBy        String?            @map("completed_by") @db.Uuid
  delegatedFromId    String?            @map("delegated_from_id") @db.Uuid
  escalatedToId      String?            @map("escalated_to_id") @db.Uuid
  escalatedAt        DateTime?          @map("escalated_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?            @map("created_by") @db.Uuid
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?            @map("updated_by") @db.Uuid
  version            Int                @default(1)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instance           WorkflowInstance   @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Restrict)
  entry              WorkflowHistory    @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)
  approvals          WorkflowApproval[]

  @@unique([tenantId, id])
  @@index([tenantId, instanceId])
  @@index([tenantId, entryId])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, assigneeRole, status])
  @@index([tenantId, escalatedToId, status])
  @@index([tenantId, status, dueAt])
  @@map("wf_tasks")
}

model WorkflowApproval {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  taskId     String       @map("task_id") @db.Uuid
  approverId String       @map("approver_id") @db.Uuid
  onBehalfOf String?      @map("on_behalf_of") @db.Uuid
  decision   String
  comment    String?
  decidedAt  DateTime     @map("decided_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?      @map("created_by") @db.Uuid
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?      @map("updated_by") @db.Uuid
  version    Int          @default(1)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  task       WorkflowTask @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, taskId])
  @@map("wf_approvals")
}

// M04 Avisos, comentarios y adjuntos (B16, ficha 17.5). Las personas, los archivos y los registros
// se guardan por identificador: el módulo los consulta por el índice de su dueño.

/// Plantilla de un tipo de aviso. Cada cambio agrega una versión; vale la de número mayor.
model NotificationTemplate {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  key           String
  versionNumber Int       @map("version_number")
  channel       String    @default("email")
  subject       String
  body          String
  urgent        Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, key, versionNumber])
  @@map("ntf_templates")
}

/// Aviso en la aplicación para una persona; aparece desde deliver_at.
model Notification {
  id         String                 @id @default(uuid(7)) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  eventId    String                 @map("event_id") @db.Uuid
  kind       String
  title      String
  body       String
  link       String?
  deliverAt  DateTime               @map("deliver_at") @db.Timestamptz(6)
  readAt     DateTime?              @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?                @map("created_by") @db.Uuid
  updatedAt  DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?                @map("updated_by") @db.Uuid
  version    Int                    @default(1)
  deletedAt  DateTime?              @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@unique([tenantId, eventId, userId])
  @@index([tenantId, userId, deliverAt])
  @@map("ntf_notifications")
}

/// Envío por correo de un aviso, con sus intentos.
model NotificationDelivery {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  notificationId    String       @map("notification_id") @db.Uuid
  templateKey       String       @map("template_key")
  templateVersion   Int          @map("template_version")
  recipient         String
  subject           String
  body              String
  link              String?
  status            String       @default("pending")
  deliverAt         DateTime     @map("deliver_at") @db.Timestamptz(6)
  nextAttemptAt     DateTime     @map("next_attempt_at") @db.Timestamptz(6)
  attempts          Int          @default(0)
  providerMessageId String?      @map("provider_message_id")
  sentAt            DateTime?    @map("sent_at") @db.Timestamptz(6)
  error             String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?      @map("created_by") @db.Uuid
  updatedAt         DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?      @map("updated_by") @db.Uuid
  version           Int          @default(1)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notification      Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, notificationId])
  @@index([status, nextAttemptAt])
  @@map("ntf_deliveries")
}

/// Preferencia de una persona por tipo de aviso y canal. Sin fila, el canal está activo.
model NotificationPreference {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventKey  String    @map("event_key")
  channel   String    @default("email")
  enabled   Boolean
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, eventKey, channel])
  @@map("ntf_preferences")
}

/// Comentario sobre cualquier registro, con las personas que menciona.
model Comment {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  body       String
  visibility String    @default("internal")
  mentionIds String[]  @map("mention_ids") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, entityType, entityId, createdAt])
  @@map("core_comments")
}

/// Archivo adjunto a cualquier registro.
model Attachment {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  fileId     String    @map("file_id") @db.Uuid
  label      String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, entityType, entityId, createdAt])
  @@map("core_attachments")
}

// Privacidad (M18, B17) ---------------------------------------------------------------------------

/// Aviso o política de privacidad versionado. Lo publicado no cambia; al publicar una versión
/// nueva de la misma clave, la anterior queda reemplazada (ficha 17.19, numeral 20.2).
model PrivacyNotice {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  key           String
  versionNumber Int              @map("version_number")
  title         String
  body          String
  purposes      String[]
  status        String           @default("draft")
  effectiveFrom DateTime?        @map("effective_from") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?          @map("created_by") @db.Uuid
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?          @map("updated_by") @db.Uuid
  version       Int              @default(1)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  consents      PrivacyConsent[]

  @@unique([tenantId, id])
  @@unique([tenantId, key, versionNumber])
  @@index([tenantId, key, status])
  @@map("prv_notices")
}

/// Autorización de tratamiento de un titular, con la versión exacta del texto aceptado y su
/// evidencia. No se borra ni se edita: solo se revoca una vez (Ley 1581, art. 9).
model PrivacyConsent {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  partyId          String        @map("party_id") @db.Uuid
  noticeId         String        @map("notice_id") @db.Uuid
  purposes         String[]
  channel          String
  grantedOn        DateTime      @map("granted_on") @db.Date
  source           String
  ipAddress        String?       @map("ip_address")
  userAgent        String?       @map("user_agent")
  evidenceFileId   String?       @map("evidence_file_id") @db.Uuid
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedBy        String?       @map("revoked_by") @db.Uuid
  revocationReason String?       @map("revocation_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?       @map("created_by") @db.Uuid
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?       @map("updated_by") @db.Uuid
  version          Int           @default(1)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notice           PrivacyNotice @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, partyId])
  @@index([tenantId, noticeId])
  @@index([tenantId, createdAt])
  @@map("prv_consents")
}

/// Registro de actividades de tratamiento: qué datos, de quién, para qué, con qué fundamento,
/// por cuánto tiempo y con qué encargados (Ley 1581, art. 4).
model ProcessingActivity {
  id                     String              @id @default(uuid(7)) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  name                   String
  purpose                String
  dataCategories         String[]            @map("data_categories")
  holderTypes            String[]            @map("holder_types")
  legalBasis             String              @map("legal_basis")
  retention              String
  internationalTransfers String?             @map("international_transfers")
  status                 String              @default("active")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?             @map("created_by") @db.Uuid
  updatedAt              DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?             @map("updated_by") @db.Uuid
  version                Int                 @default(1)
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenant                 Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  processors             ActivityProcessor[]

  @@unique([tenantId, id])
  @@map("prv_processing_activities")
}

/// Encargado o proveedor con acceso a datos personales, con su contrato de transmisión
/// (Ley 1581, arts. 17, 18 y 26).
model DataProcessor {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  partyId        String              @map("party_id") @db.Uuid
  service        String
  country        String
  contractFileId String?             @map("contract_file_id") @db.Uuid
  reviewOn       DateTime            @map("review_on") @db.Date
  status         String              @default("active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?             @map("created_by") @db.Uuid
  updatedAt      DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?             @map("updated_by") @db.Uuid
  version        Int                 @default(1)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  activities     ActivityProcessor[]

  @@unique([tenantId, id])
  @@index([tenantId, partyId])
  @@map("prv_processors")
}

/// Encargados que participan en cada actividad de tratamiento.
model ActivityProcessor {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  activityId  String             @map("activity_id") @db.Uuid
  processorId String             @map("processor_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?            @map("created_by") @db.Uuid
  updatedAt   DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?            @map("updated_by") @db.Uuid
  version     Int                @default(1)
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  activity    ProcessingActivity @relation(fields: [tenantId, activityId], references: [tenantId, id], onDelete: Restrict)
  processor   DataProcessor      @relation(fields: [tenantId, processorId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, activityId, processorId])
  @@index([tenantId, processorId])
  @@map("prv_activity_processors")
}

// Comercial (M05, B22) ---------------------------------------------------------------------------

/// Campañas: de dónde llegan los prospectos.
model CrmCampaign {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  channel   String
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  budget    Decimal?  @db.Decimal(18, 2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads     CrmLead[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("crm_campaigns")
}

/// Prospectos: nuevo → calificado → convertido o descartado (ficha 17.6). La persona es un tercero
/// (pty_parties) y su autorización de tratamiento vive en prv_consents.
model CrmLead {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  code               String
  source             String
  campaignId         String?         @map("campaign_id") @db.Uuid
  partyId            String          @map("party_id") @db.Uuid
  companyName        String?         @map("company_name")
  need               String
  consentId          String          @map("consent_id") @db.Uuid
  status             String          @default("new")
  ownerId            String?         @map("owner_id") @db.Uuid
  discardReason      String?         @map("discard_reason")
  discardNote        String?         @map("discard_note")
  /// El trámite de la tarea «Contactar al prospecto» en Mis tareas.
  workflowInstanceId String?         @map("workflow_instance_id") @db.Uuid
  qualifiedAt        DateTime?       @map("qualified_at") @db.Timestamptz(6)
  closedAt           DateTime?       @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?         @map("created_by") @db.Uuid
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?         @map("updated_by") @db.Uuid
  version            Int             @default(1)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campaign           CrmCampaign?    @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict)
  opportunity        CrmOpportunity?
  activities         CrmActivity[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, partyId])
  @@index([tenantId, campaignId])
  @@index([tenantId, ownerId])
  @@map("crm_leads")
}

/// Oportunidades: prospección → diagnóstico → propuesta → negociación → ganada o perdida.
model CrmOpportunity {
  id             String        @id @default(uuid(7)) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  code           String
  partyId        String        @map("party_id") @db.Uuid
  leadId         String?       @map("lead_id") @db.Uuid
  title          String
  stage          String        @default("prospecting")
  estimatedValue Decimal       @map("estimated_value") @db.Decimal(18, 2)
  probability    Int           @db.SmallInt
  expectedClose  DateTime      @map("expected_close") @db.Date
  ownerId        String?       @map("owner_id") @db.Uuid
  lostReason     String?       @map("lost_reason")
  lostNote       String?       @map("lost_note")
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?       @map("updated_by") @db.Uuid
  version        Int           @default(1)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead           CrmLead?      @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)
  activities     CrmActivity[]
  quotes         CrmQuote[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, leadId])
  @@index([tenantId, stage])
  @@index([tenantId, partyId])
  @@index([tenantId, ownerId])
  @@index([tenantId, createdAt])
  @@map("crm_opportunities")
}

/// Llamadas, reuniones, tareas y correos de un prospecto o de una oportunidad, con su recordatorio.
model CrmActivity {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  leadId        String?         @map("lead_id") @db.Uuid
  opportunityId String?         @map("opportunity_id") @db.Uuid
  type          String
  subject       String
  notes         String?
  dueAt         DateTime        @map("due_at") @db.Timestamptz(6)
  doneAt        DateTime?       @map("done_at") @db.Timestamptz(6)
  outcome       String?
  assigneeId    String?         @map("assignee_id") @db.Uuid
  remindedAt    DateTime?       @map("reminded_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?         @map("created_by") @db.Uuid
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?         @map("updated_by") @db.Uuid
  version       Int             @default(1)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead          CrmLead?        @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)
  opportunity   CrmOpportunity? @relation(fields: [tenantId, opportunityId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, leadId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, assigneeId, doneAt])
  @@index([tenantId, dueAt])
  @@map("crm_activities")
}

/// Portafolio de servicios con su tarifa vigente (B23). Guarda la clave del impuesto, no la tarifa:
/// la tarifa se lee de fin_tax_parameters al cotizar.
model CrmService {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  unit        String
  basePrice   Decimal        @map("base_price") @db.Decimal(18, 2)
  taxKey      String         @map("tax_key")
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?        @map("created_by") @db.Uuid
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?        @map("updated_by") @db.Uuid
  version     Int            @default(1)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quoteItems  CrmQuoteItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@map("crm_services")
}

/// Cotizaciones (B23): borrador → en aprobación → aprobada → enviada → aceptada, rechazada o
/// vencida; una versión nueva reemplaza a la anterior. Cada versión es una fila con el mismo código.
/// Una cotización fuera de borrador no cambia su contenido (lo revisa la base). La evidencia de la
/// aceptación o el rechazo en línea queda en las columnas response_*.
model CrmQuote {
  id                 String         @id @default(uuid(7)) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  code               String
  versionNumber      Int            @map("version_number")
  previousId         String?        @map("previous_id") @db.Uuid
  opportunityId      String         @map("opportunity_id") @db.Uuid
  partyId            String         @map("party_id") @db.Uuid
  status             String         @default("draft")
  validUntil         DateTime       @map("valid_until") @db.Date
  paymentTerms       String         @map("payment_terms")
  deliveryTerms      String         @map("delivery_terms")
  warranty           String?
  notes              String?
  subtotal           Decimal        @db.Decimal(18, 2)
  discountTotal      Decimal        @map("discount_total") @db.Decimal(18, 2)
  taxTotal           Decimal        @map("tax_total") @db.Decimal(18, 2)
  total              Decimal        @db.Decimal(18, 2)
  largestDiscount    Decimal        @map("largest_discount") @db.Decimal(5, 2)
  /// Tope vigente cuando se pidió el envío; vacío mientras es borrador.
  discountCap        Decimal?       @map("discount_cap") @db.Decimal(5, 2)
  requiresApproval   Boolean        @default(false) @map("requires_approval")
  /// El trámite de la aprobación de la Dirección en Mis tareas, si la necesitó.
  workflowInstanceId String?        @map("workflow_instance_id") @db.Uuid
  submittedAt        DateTime?      @map("submitted_at") @db.Timestamptz(6)
  decidedBy          String?        @map("decided_by") @db.Uuid
  decidedAt          DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?        @map("decision_note")
  /// none mientras no está aprobada; pending hasta que el worker genera el PDF FT-COM-001.
  pdfStatus          String         @default("none") @map("pdf_status")
  pdfFileId          String?        @map("pdf_file_id") @db.Uuid
  pdfSha256          String?        @map("pdf_sha256")
  recipientName      String?        @map("recipient_name")
  recipientEmail     String?        @map("recipient_email")
  sentBy             String?        @map("sent_by") @db.Uuid
  sentAt             DateTime?      @map("sent_at") @db.Timestamptz(6)
  emailSentAt        DateTime?      @map("email_sent_at") @db.Timestamptz(6)
  /// Huella SHA-256 de la llave del enlace del cliente; la llave solo va en el correo.
  linkTokenHash      String?        @unique @map("link_token_hash")
  linkExpiresAt      DateTime?      @map("link_expires_at") @db.Timestamptz(6)
  response           String?
  respondedAt        DateTime?      @map("responded_at") @db.Timestamptz(6)
  respondedByName    String?        @map("responded_by_name")
  responseReason     String?        @map("response_reason")
  responseIp         String?        @map("response_ip")
  responseUserAgent  String?        @map("response_user_agent")
  responsePdfSha256  String?        @map("response_pdf_sha256")
  closedAt           DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?        @map("created_by") @db.Uuid
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?        @map("updated_by") @db.Uuid
  version            Int            @default(1)
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  opportunity        CrmOpportunity @relation(fields: [tenantId, opportunityId], references: [tenantId, id], onDelete: Restrict)
  previous           CrmQuote?      @relation("QuoteVersions", fields: [tenantId, previousId], references: [tenantId, id], onDelete: Restrict)
  next               CrmQuote[]     @relation("QuoteVersions")
  items              CrmQuoteItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, versionNumber])
  @@index([tenantId, opportunityId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("crm_quotes")
}

/// Ítems de una cotización. Guardan la tarifa del impuesto usada y los totales de la línea, para
/// que una cotización enviada nunca cambie aunque cambien el portafolio o los impuestos.
model CrmQuoteItem {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  quoteId         String      @map("quote_id") @db.Uuid
  position        Int         @db.SmallInt
  serviceId       String?     @map("service_id") @db.Uuid
  description     String
  unit            String
  quantity        Decimal     @db.Decimal(9, 2)
  unitPrice       Decimal     @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal     @map("discount_percent") @db.Decimal(5, 2)
  taxKey          String      @map("tax_key")
  taxRate         Decimal     @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal    Decimal     @map("line_subtotal") @db.Decimal(18, 2)
  lineDiscount    Decimal     @map("line_discount") @db.Decimal(18, 2)
  lineTax         Decimal     @map("line_tax") @db.Decimal(18, 2)
  lineTotal       Decimal     @map("line_total") @db.Decimal(18, 2)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?     @map("created_by") @db.Uuid
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?     @map("updated_by") @db.Uuid
  version         Int         @default(1)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  quote           CrmQuote    @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict)
  service         CrmService? @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, quoteId])
  @@index([tenantId, serviceId])
  @@map("crm_quote_items")
}

// Finanzas (M10): parámetros tributarios, adelantados en B23 ------------------------------------

/// Parámetros tributarios vigentes (numeral 12.4), validados por el Contador. Cada clave tiene
/// vigencias: un cambio crea una fila nueva y cierra la anterior el día antes.
model FinTaxParameter {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  key        String
  label      String
  rate       Decimal   @db.Decimal(5, 2)
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  legalBasis String    @map("legal_basis")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, key, validFrom])
  @@map("fin_tax_parameters")
}

/// Factura operativa (B31): se solicita desde un hito facturable y luego se registran los datos
/// fiscales tal como los emitió el software habilitado. ARZA ONE no calcula ni transmite impuestos.
model FinInvoice {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  code             String
  partyId          String           @map("party_id") @db.Uuid
  contractId       String?          @map("contract_id") @db.Uuid
  milestoneId      String           @map("milestone_id") @db.Uuid
  requestedAmount  Decimal          @map("requested_amount") @db.Decimal(18, 2)
  status           String           @default("requested")
  issueDate        DateTime?        @map("issue_date") @db.Date
  dueDate          DateTime?        @map("due_date") @db.Date
  subtotal         Decimal?         @db.Decimal(18, 2)
  taxTotal         Decimal?         @map("tax_total") @db.Decimal(18, 2)
  withholdingTotal Decimal?         @map("withholding_total") @db.Decimal(18, 2)
  total            Decimal?         @db.Decimal(18, 2)
  fiscalNumber     String?          @map("fiscal_number")
  fiscalUuid       String?          @map("fiscal_uuid")
  fiscalFileId     String?          @map("fiscal_file_id") @db.Uuid
  requestKey       String           @map("request_key")
  approvalKey      String?          @map("approval_key")
  fiscalKey        String?          @map("fiscal_key")
  approvedBy       String?          @map("approved_by") @db.Uuid
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  voidedBy         String?          @map("voided_by") @db.Uuid
  voidedAt         DateTime?        @map("voided_at") @db.Timestamptz(6)
  voidReason       String?          @map("void_reason")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?          @map("created_by") @db.Uuid
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?          @map("updated_by") @db.Uuid
  version          Int              @default(1)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items            FinInvoiceItem[]
  creditNotes      FinCreditNote[]
  payments         FinPayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, requestKey])
  @@unique([tenantId, fiscalNumber])
  @@unique([tenantId, fiscalUuid])
  /// Una sola factura vigente por hito: índice único parcial en el SQL de la migración (las
  /// anuladas liberan el hito).
  @@index([tenantId, milestoneId])
  @@index([tenantId, partyId, status])
  @@map("fin_invoices")
}

/// Línea de factura; el valor solicitado proviene del hito. Los campos fiscales se registran desde
/// el documento externo y no se recalculan en la plataforma.
model FinInvoiceItem {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  invoiceId   String     @map("invoice_id") @db.Uuid
  position    Int
  description String
  quantity    Decimal    @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(18, 2)
  taxRate     Decimal?   @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal    @map("line_total") @db.Decimal(18, 2)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?    @map("created_by") @db.Uuid
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?    @map("updated_by") @db.Uuid
  version     Int        @default(1)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice     FinInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, position])
  @@map("fin_invoice_items")
}

/// Nota crédito emitida en el software fiscal externo. B31 excluye las notas débito.
model FinCreditNote {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  invoiceId    String     @map("invoice_id") @db.Uuid
  reason       String
  amount       Decimal    @db.Decimal(18, 2)
  issueDate    DateTime   @map("issue_date") @db.Date
  fiscalNumber String     @map("fiscal_number")
  fiscalUuid   String?    @map("fiscal_uuid")
  fiscalFileId String     @map("fiscal_file_id") @db.Uuid
  requestKey   String     @map("request_key")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?    @map("updated_by") @db.Uuid
  version      Int        @default(1)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice      FinInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, fiscalNumber])
  @@unique([tenantId, requestKey])
  @@index([tenantId, invoiceId])
  @@map("fin_credit_notes")
}

/// Recaudo aplicado a una factura concreta (B31); los soportes se conservan como referencias.
model FinPayment {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  invoiceId     String     @map("invoice_id") @db.Uuid
  paidOn        DateTime   @map("paid_on") @db.Date
  amount        Decimal    @db.Decimal(18, 2)
  method        String
  reference     String?
  supportFileId String?    @map("support_file_id") @db.Uuid
  requestKey    String     @map("request_key")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?    @map("created_by") @db.Uuid
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?    @map("updated_by") @db.Uuid
  version       Int        @default(1)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice       FinInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, requestKey])
  @@index([tenantId, invoiceId, paidOn])
  @@map("fin_payments")
}

// Finanzas (M10, B32): presupuesto, gastos, caja menor, conciliación, certificación de costos,
// cierre de periodo y exportación contable. Un periodo cerrado no admite cambios (disparador
// fin_reject_closed_period en la migración).

/// Presupuesto anual por centro de costo: borrador → aprobado. Uno por año.
model FinBudget {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  year       Int
  status     String          @default("draft")
  approvedBy String?         @map("approved_by") @db.Uuid
  approvedAt DateTime?       @map("approved_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?         @map("created_by") @db.Uuid
  updatedAt  DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?         @map("updated_by") @db.Uuid
  version    Int             @default(1)
  deletedAt  DateTime?       @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lines      FinBudgetLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, year])
  @@map("fin_budgets")
}

/// Lo planeado por centro de costo, rubro y mes. Lo ejecutado se calcula, no se guarda.
model FinBudgetLine {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  budgetId     String    @map("budget_id") @db.Uuid
  costCenterId String    @map("cost_center_id") @db.Uuid
  category     String
  month        Int       @db.SmallInt
  planned      Decimal   @db.Decimal(18, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  budget       FinBudget @relation(fields: [tenantId, budgetId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  /// Una línea vigente por centro, rubro y mes: índice único parcial en el SQL de la migración.
  @@index([tenantId, budgetId])
  @@map("fin_budget_lines")
}

/// Gasto con soporte: pendiente → aprobado o rechazado por otra persona.
model FinExpense {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String
  costCenterId  String    @map("cost_center_id") @db.Uuid
  supplierId    String?   @map("supplier_id") @db.Uuid
  expenseDate   DateTime  @map("expense_date") @db.Date
  amount        Decimal   @db.Decimal(18, 2)
  category      String
  description   String
  supportFileId String    @map("support_file_id") @db.Uuid
  status        String    @default("pending")
  decidedBy     String?   @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?   @map("decision_note")
  requestKey    String    @map("request_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, requestKey])
  @@index([tenantId, expenseDate, status])
  @@index([tenantId, createdBy])
  @@map("fin_expenses")
}

/// Libro de la caja menor (una por empresa): apertura, vales y reembolsos con el saldo resultante.
model FinPettyCash {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String
  movementDate  DateTime  @map("movement_date") @db.Date
  type          String
  amount        Decimal   @db.Decimal(18, 2)
  concept       String
  costCenterId  String?   @map("cost_center_id") @db.Uuid
  category      String?
  supportFileId String?   @map("support_file_id") @db.Uuid
  balance       Decimal   @db.Decimal(18, 2)
  requestKey    String    @map("request_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  version       Int       @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, requestKey])
  @@index([tenantId, movementDate])
  @@map("fin_petty_cash")
}

/// Conciliación de una cuenta bancaria en un mes; la cuenta va por su nombre corto.
model FinBankReconciliation {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  account      String
  period       String
  bookBalance  Decimal   @map("book_balance") @db.Decimal(18, 2)
  bankBalance  Decimal   @map("bank_balance") @db.Decimal(18, 2)
  differences  Json      @default("[]")
  status       String    @default("draft")
  reconciledBy String?   @map("reconciled_by") @db.Uuid
  reconciledAt DateTime? @map("reconciled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, account, period])
  @@map("fin_bank_reconciliations")
}

/// Certificación de costos de desarrollo de un proyecto en un mes: horas aprobadas y valor.
model FinCostCertification {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  code       String
  projectId  String    @map("project_id") @db.Uuid
  period     String
  hours      Decimal   @db.Decimal(10, 2)
  amount     Decimal   @db.Decimal(18, 2)
  phase      String
  requestKey String    @map("request_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, projectId, period])
  @@unique([tenantId, requestKey])
  @@map("fin_cost_certifications")
}

/// Mes contable cerrado. Solo existen filas de meses cerrados y no se reabren (decisión 3 del B32).
model FinPeriod {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  period    String
  status    String    @default("closed")
  closedBy  String    @map("closed_by") @db.Uuid
  closedAt  DateTime  @map("closed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, period])
  @@map("fin_periods")
}

/// Lote exportado al software contable: preliminar (mes abierto) o definitivo (al cerrar).
model FinExportBatch {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  period     String
  kind       String
  rowCount   Int       @map("row_count")
  totals     Json
  checksum   String
  fileName   String    @map("file_name")
  fileId     String?   @map("file_id") @db.Uuid
  exportedBy String    @map("exported_by") @db.Uuid
  exportedAt DateTime  @map("exported_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  /// Un solo lote definitivo por mes: índice único parcial en el SQL de la migración.
  @@index([tenantId, period])
  @@map("fin_export_batches")
}

// Contratos (M06, B24) ---------------------------------------------------------------------------

/// Biblioteca de cláusulas aprobadas. Cada cambio es una versión nueva; los contratos guardan la
/// versión que usaron. El texto lleva variables {{así}} que se llenan al generar el contrato.
model CtrClause {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  key            String
  clauseVersion  Int       @map("clause_version")
  title          String
  body           String
  /// Lleva número (PRIMERA, SEGUNDA…); el encabezado de las partes no.
  numbered       Boolean
  /// El asesor jurídico ya validó el texto (numeral 19.4).
  legalValidated Boolean   @default(false) @map("legal_validated")
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime  @map("approved_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  version        Int       @default(1)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, key, clauseVersion])
  @@map("ctr_clause_library")
}

/// Plantillas CT-COM y OS-COM: qué cláusulas de la biblioteca lleva cada una y en qué orden.
model CtrTemplate {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  code          String
  name          String
  kind          String
  formatVersion String              @map("format_version")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?             @map("created_by") @db.Uuid
  updatedAt     DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?             @map("updated_by") @db.Uuid
  version       Int                 @default(1)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clauses       CtrTemplateClause[]
  contracts     CtrContract[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("ctr_templates")
}

model CtrTemplateClause {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  templateId String      @map("template_id") @db.Uuid
  position   Int         @db.SmallInt
  clauseKey  String      @map("clause_key")
  /// No se puede quitar del contrato.
  required   Boolean
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?     @map("created_by") @db.Uuid
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?     @map("updated_by") @db.Uuid
  version    Int         @default(1)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template   CtrTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, templateId, position])
  @@unique([tenantId, templateId, clauseKey])
  @@map("ctr_template_clauses")
}

/// Contratos y órdenes de servicio. El cliente (pty_parties), la cotización (crm_quotes), el
/// responsable y los PDF (doc_files) se guardan por identificador, sin llaves hacia otros módulos.
model CtrContract {
  id                   String              @id @default(uuid(7)) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  code                 String
  kind                 String
  templateId           String              @map("template_id") @db.Uuid
  partyId              String              @map("party_id") @db.Uuid
  quoteId              String?             @map("quote_id") @db.Uuid
  title                String
  object               String
  value                Decimal?            @db.Decimal(18, 2)
  paymentTerms         String?             @map("payment_terms")
  startsOn             DateTime            @map("starts_on") @db.Date
  endsOn               DateTime            @map("ends_on") @db.Date
  renewal              String
  responsibleId        String?             @map("responsible_id") @db.Uuid
  clientSignerName     String              @map("client_signer_name")
  clientSignerDocument String              @map("client_signer_document")
  /// Valores con que se llenaron las variables de las cláusulas, tal como se imprimieron.
  variableValues       Json                @map("variable_values")
  hasModifiedClauses   Boolean             @default(false) @map("has_modified_clauses")
  status               String              @default("draft")
  workflowInstanceId   String?             @map("workflow_instance_id") @db.Uuid
  submittedAt          DateTime?           @map("submitted_at") @db.Timestamptz(6)
  decidedBy            String?             @map("decided_by") @db.Uuid
  decidedAt            DateTime?           @map("decided_at") @db.Timestamptz(6)
  decisionNote         String?             @map("decision_note")
  legalNote            String?             @map("legal_note")
  /// none mientras no está aprobado; pending hasta que el worker genera el PDF definitivo.
  pdfStatus            String              @default("none") @map("pdf_status")
  pdfFileId            String?             @map("pdf_file_id") @db.Uuid
  pdfSha256            String?             @map("pdf_sha256")
  signedFileId         String?             @map("signed_file_id") @db.Uuid
  signedOn             DateTime?           @map("signed_on") @db.Date
  signedBy             String?             @map("signed_by") @db.Uuid
  terminatedOn         DateTime?           @map("terminated_on") @db.Date
  terminationReason    String?             @map("termination_reason")
  terminatedBy         String?             @map("terminated_by") @db.Uuid
  /// Última alerta de vencimiento enviada: 90, 60 o 30 días.
  lastAlertDays        Int?                @map("last_alert_days") @db.SmallInt
  closedAt             DateTime?           @map("closed_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?             @map("created_by") @db.Uuid
  updatedAt            DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy            String?             @map("updated_by") @db.Uuid
  version              Int                 @default(1)
  deletedAt            DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template             CtrTemplate         @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  clauses              CtrContractClause[]
  obligations          CtrObligation[]
  amendments           CtrAmendment[]
  envelopes            SigEnvelope[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, partyId])
  @@index([tenantId, quoteId])
  @@index([tenantId, responsibleId])
  @@index([tenantId, createdAt])
  @@map("ctr_contracts")
}

/// El texto del contrato, cláusula por cláusula. Una modificada o nueva exige a la Dirección.
model CtrContractClause {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  contractId    String      @map("contract_id") @db.Uuid
  position      Int         @db.SmallInt
  clauseKey     String?     @map("clause_key")
  clauseVersion Int?        @map("clause_version")
  title         String
  body          String
  /// library, modified o added.
  origin        String
  numbered      Boolean
  required      Boolean
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?     @map("created_by") @db.Uuid
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?     @map("updated_by") @db.Uuid
  version       Int         @default(1)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract      CtrContract @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, contractId])
  @@map("ctr_contract_clauses")
}

/// Obligaciones e hitos del contrato, con su responsable y su fecha.
model CtrObligation {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  contractId    String      @map("contract_id") @db.Uuid
  description   String
  responsibleId String      @map("responsible_id") @db.Uuid
  dueOn         DateTime    @map("due_on") @db.Date
  status        String      @default("pending")
  doneAt        DateTime?   @map("done_at") @db.Timestamptz(6)
  doneBy        String?     @map("done_by") @db.Uuid
  doneNote      String?     @map("done_note")
  /// Cuando se avisó al responsable que se acerca la fecha.
  remindedAt    DateTime?   @map("reminded_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?     @map("created_by") @db.Uuid
  updatedAt     DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?     @map("updated_by") @db.Uuid
  version       Int         @default(1)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract      CtrContract @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, contractId])
  @@index([tenantId, status, dueOn])
  @@map("ctr_obligations")
}

/// Otrosíes y prórrogas. Su texto no cambia después de creado; rigen al registrar la firmada.
model CtrAmendment {
  id                 String      @id @default(uuid(7)) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  contractId         String      @map("contract_id") @db.Uuid
  code               String
  sequence           Int         @db.SmallInt
  kind               String
  status             String
  summary            String
  body               String
  effectiveOn        DateTime    @map("effective_on") @db.Date
  newEndsOn          DateTime?   @map("new_ends_on") @db.Date
  newValue           Decimal?    @map("new_value") @db.Decimal(18, 2)
  workflowInstanceId String?     @map("workflow_instance_id") @db.Uuid
  decidedBy          String?     @map("decided_by") @db.Uuid
  decidedAt          DateTime?   @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?     @map("decision_note")
  pdfStatus          String      @default("none") @map("pdf_status")
  pdfFileId          String?     @map("pdf_file_id") @db.Uuid
  pdfSha256          String?     @map("pdf_sha256")
  signedFileId       String?     @map("signed_file_id") @db.Uuid
  signedOn           DateTime?   @map("signed_on") @db.Date
  signedBy           String?     @map("signed_by") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?     @map("created_by") @db.Uuid
  updatedAt          DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?     @map("updated_by") @db.Uuid
  version            Int         @default(1)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract           CtrContract @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, contractId, sequence])
  @@map("ctr_amendments")
}

/// Proceso de firma electrónica de un contrato o un otrosí aprobado (B25, capítulo 19).
model SigEnvelope {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  code               String
  source             String
  /// El contrato del documento; vacío en un acta de entrega de un proyecto (B27).
  contractId         String?           @map("contract_id") @db.Uuid
  amendmentId        String?           @map("amendment_id") @db.Uuid
  /// Otro documento que se firma (B27: el acta de entrega de un proyecto) y su cliente.
  sourceId           String?           @map("source_id") @db.Uuid
  partyId            String?           @map("party_id") @db.Uuid
  /// El PDF aprobado que se firma y su huella: no cambian.
  documentFileId     String            @map("document_file_id") @db.Uuid
  documentSha256     String            @map("document_sha256")
  documentCode       String            @map("document_code")
  documentTitle      String            @map("document_title")
  level              Int               @default(2) @db.SmallInt
  status             String            @default("draft")
  message            String?
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(6)
  sentAt             DateTime?         @map("sent_at") @db.Timestamptz(6)
  sentBy             String?           @map("sent_by") @db.Uuid
  /// Llave Idempotency-Key con que se envió: repetir el envío con ella no cambia nada.
  sendKey            String?           @map("send_key")
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz(6)
  closedReason       String?           @map("closed_reason")
  /// Huella del último evento de la cadena; la del documento mientras no hay eventos.
  lastEventHash      String            @map("last_event_hash")
  eventCount         Int               @default(0) @map("event_count")
  workflowInstanceId String?           @map("workflow_instance_id") @db.Uuid
  /// none hasta que firman todos; pending mientras el worker arma el documento firmado.
  sealStatus         String            @default("none") @map("seal_status")
  signedFileId       String?           @map("signed_file_id") @db.Uuid
  signedSha256       String?           @map("signed_sha256")
  evidenceFileId     String?           @map("evidence_file_id") @db.Uuid
  verificationCode   String?           @map("verification_code")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?           @map("created_by") @db.Uuid
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?           @map("updated_by") @db.Uuid
  version            Int               @default(1)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract           CtrContract?      @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict)
  signers            SigSigner[]
  events             SigEvent[]
  verifications      SigVerification[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([verificationCode])
  @@index([tenantId, contractId])
  @@index([tenantId, status])
  @@index([signedSha256])
  @@index([tenantId, sourceId])
  @@map("sig_envelopes")
}

/// Quien firma: una persona autorizada del cliente o la persona de la Dirección.
model SigSigner {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  envelopeId      String      @map("envelope_id") @db.Uuid
  kind            String
  partyId         String?     @map("party_id") @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  name            String
  email           String
  idNumber        String      @map("id_number")
  role            String
  signOrder       Int         @map("sign_order") @db.SmallInt
  status          String      @default("waiting")
  /// Huella de la llave del último enlace enviado; la llave solo va en el correo.
  linkTokenHash   String?     @map("link_token_hash")
  linkExpiresAt   DateTime?   @map("link_expires_at") @db.Timestamptz(6)
  /// Correo por enviar: invitation, reminder o copy.
  mailPending     String?     @map("mail_pending")
  codeRequestedAt DateTime?   @map("code_requested_at") @db.Timestamptz(6)
  codeHash        String?     @map("code_hash")
  codeExpiresAt   DateTime?   @map("code_expires_at") @db.Timestamptz(6)
  codeSentAt      DateTime?   @map("code_sent_at") @db.Timestamptz(6)
  codeAttempts    Int         @default(0) @map("code_attempts") @db.SmallInt
  codeLocked      Boolean     @default(false) @map("code_locked")
  ticketHash      String?     @map("ticket_hash")
  ticketExpiresAt DateTime?   @map("ticket_expires_at") @db.Timestamptz(6)
  openedAt        DateTime?   @map("opened_at") @db.Timestamptz(6)
  reminders       Int         @default(0) @db.SmallInt
  lastNotifiedAt  DateTime?   @map("last_notified_at") @db.Timestamptz(6)
  method          String?
  signedAt        DateTime?   @map("signed_at") @db.Timestamptz(6)
  signIp          String?     @map("sign_ip")
  signUserAgent   String?     @map("sign_user_agent")
  acceptanceText  String?     @map("acceptance_text")
  rejectedAt      DateTime?   @map("rejected_at") @db.Timestamptz(6)
  rejectReason    String?     @map("reject_reason")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?     @map("created_by") @db.Uuid
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?     @map("updated_by") @db.Uuid
  version         Int         @default(1)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  envelope        SigEnvelope @relation(fields: [tenantId, envelopeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, envelopeId, signOrder])
  @@unique([linkTokenHash])
  @@index([tenantId, envelopeId])
  @@map("sig_signers")
}

/// Cadena de eventos del proceso de firma: solo se agrega; cada eslabón lleva la huella del anterior.
model SigEvent {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  envelopeId String      @map("envelope_id") @db.Uuid
  signerId   String?     @map("signer_id") @db.Uuid
  sequence   Int
  type       String
  ip         String?
  userAgent  String?     @map("user_agent")
  occurredAt DateTime    @map("occurred_at") @db.Timestamptz(6)
  details    Json        @default("{}")
  prevHash   String      @map("prev_hash")
  hash       String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  envelope   SigEnvelope @relation(fields: [tenantId, envelopeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, envelopeId, sequence])
  @@index([tenantId, envelopeId])
  @@map("sig_events")
}

/// Consultas a la página pública de verificación que encontraron un documento firmado.
model SigVerification {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  envelopeId String      @map("envelope_id") @db.Uuid
  method     String
  result     String
  ip         String?
  verifiedAt DateTime    @map("verified_at") @db.Timestamptz(6)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  envelope   SigEnvelope @relation(fields: [tenantId, envelopeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, envelopeId])
  @@map("sig_verifications")
}

/// Proyectos (B26, ficha 17.8). El contrato y el cliente se guardan por identificador, sin llaves
/// hacia tablas de otros módulos (numeral 8.3).
model PrjProject {
  id                     String            @id @default(uuid(7)) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  code                   String
  contractId             String?           @map("contract_id") @db.Uuid
  partyId                String            @map("party_id") @db.Uuid
  name                   String
  type                   String
  methodology            String
  description            String?
  status                 String            @default("planning")
  /// Por qué está en riesgo o pausado.
  statusReason           String?           @map("status_reason")
  startsOn               DateTime          @map("starts_on") @db.Date
  endsOn                 DateTime          @map("ends_on") @db.Date
  budgetHours            Decimal           @map("budget_hours") @db.Decimal(7, 1)
  budgetAmount           Decimal?          @map("budget_amount") @db.Decimal(18, 2)
  managerId              String            @map("manager_id") @db.Uuid
  /// Autorización de la Dirección para iniciar sin contrato vigente: none, requested, granted, denied.
  authorizationStatus    String            @default("none") @map("authorization_status")
  authorizationReason    String?           @map("authorization_reason")
  authorizationNote      String?           @map("authorization_note")
  authorizationDecidedBy String?           @map("authorization_decided_by") @db.Uuid
  authorizationDecidedAt DateTime?         @map("authorization_decided_at") @db.Timestamptz(6)
  workflowInstanceId     String?           @map("workflow_instance_id") @db.Uuid
  startedAt              DateTime?         @map("started_at") @db.Timestamptz(6)
  /// Costo promedio de una hora del equipo, para la rentabilidad (B27).
  hourCost               Decimal?          @map("hour_cost") @db.Decimal(18, 2)
  /// Días que tiene el cliente para responder un acta de entrega (B27).
  respondDays            Int               @default(10) @map("respond_days") @db.SmallInt
  /// El contrato prevé la aceptación tácita, y en qué cláusula (ficha 17.8).
  tacitAcceptance        Boolean           @default(false) @map("tacit_acceptance")
  tacitClause            String?           @map("tacit_clause")
  /// Se ve en el portal del cliente desde que inicia (B30, decisión 2).
  portalVisible          Boolean           @default(true) @map("portal_visible")
  closingStartedAt       DateTime?         @map("closing_started_at") @db.Timestamptz(6)
  closedAt               DateTime?         @map("closed_at") @db.Timestamptz(6)
  /// Lecciones aprendidas, al cerrar.
  closingNote            String?           @map("closing_note")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?           @map("created_by") @db.Uuid
  updatedAt              DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?           @map("updated_by") @db.Uuid
  version                Int               @default(1)
  deletedAt              DateTime?         @map("deleted_at") @db.Timestamptz(6)
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members                PrjMember[]
  milestones             PrjMilestone[]
  sprints                PrjSprint[]
  items                  PrjItem[]
  links                  PrjExternalLink[]
  timeEntries            PrjTimeEntry[]
  deliverables           PrjDeliverable[]
  acceptances            PrjAcceptance[]
  risks                  PrjRisk[]
  releases               PrjRelease[]
  codeReviews            PrjCodeReview[]
  incidents              PrjIncident[]
  clientAccess           PrjClientAccess[]
  sharedFiles            PrjSharedFile[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, contractId])
  @@index([tenantId, partyId])
  @@map("prj_projects")
}

/// Equipo del proyecto. Retirar a un miembro le quita el acceso de inmediato (deleted_at).
model PrjMember {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  role          String
  allocationPct Int        @map("allocation_pct") @db.SmallInt
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?    @map("created_by") @db.Uuid
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?    @map("updated_by") @db.Uuid
  version       Int        @default(1)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project       PrjProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@index([tenantId, userId])
  @@map("prj_members")
}

/// Hitos con el porcentaje del valor que se factura al cumplirlos; entre todos, máximo 100 %.
model PrjMilestone {
  id             String     @id @default(uuid(7)) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  name           String
  dueOn          DateTime   @map("due_on") @db.Date
  billingPct     Decimal    @map("billing_pct") @db.Decimal(5, 2)
  status         String     @default("pending")
  doneAt         DateTime?  @map("done_at") @db.Timestamptz(6)
  /// Listo para facturar (B27): cuándo y cuánto, el porcentaje sobre el valor del contrato.
  billableAt     DateTime?  @map("billable_at") @db.Timestamptz(6)
  billableAmount Decimal?   @map("billable_amount") @db.Decimal(18, 2)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?    @map("created_by") @db.Uuid
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?    @map("updated_by") @db.Uuid
  version        Int        @default(1)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project        PrjProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  deliverables PrjDeliverable[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@map("prj_milestones")
}

/// Iteraciones. Solo una en curso por proyecto; al cerrarla, lo no terminado vuelve a pendientes.
model PrjSprint {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  name      String
  startsOn  DateTime   @map("starts_on") @db.Date
  endsOn    DateTime   @map("ends_on") @db.Date
  goal      String?
  status    String     @default("planned")
  closedAt  DateTime?  @map("closed_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?    @map("created_by") @db.Uuid
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?    @map("updated_by") @db.Uuid
  version   Int        @default(1)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project   PrjProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  items     PrjItem[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@map("prj_sprints")
}

/// Épicas, historias, tareas y defectos, numerados dentro de su proyecto (PRY-2026-0001-12).
model PrjItem {
  id                 String          @id @default(uuid(7)) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  projectId          String          @map("project_id") @db.Uuid
  parentId           String?         @map("parent_id") @db.Uuid
  type               String
  number             Int
  code               String
  title              String
  description        String?
  acceptanceCriteria String?         @map("acceptance_criteria")
  status             String          @default("pending")
  priority           String          @default("normal")
  estimateHours      Decimal?        @map("estimate_hours") @db.Decimal(4, 1)
  assigneeId         String?         @map("assignee_id") @db.Uuid
  sprintId           String?         @map("sprint_id") @db.Uuid
  /// Nota de pruebas, exigida para terminar; desde el B27 también una revisión FT-TEC-002 aprobada.
  reviewUrl          String?         @map("review_url")
  testNote           String?         @map("test_note")
  doneAt             DateTime?       @map("done_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?         @map("created_by") @db.Uuid
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?         @map("updated_by") @db.Uuid
  version            Int             @default(1)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project            PrjProject      @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  parent             PrjItem?        @relation("PrjItemParent", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children           PrjItem[]       @relation("PrjItemParent")
  sprint             PrjSprint?      @relation(fields: [tenantId, sprintId], references: [tenantId, id], onDelete: Restrict)
  timeEntries        PrjTimeEntry[]
  codeReviews        PrjCodeReview[]

  @@unique([tenantId, id])
  @@unique([tenantId, projectId, number])
  @@index([tenantId, projectId, status])
  @@index([tenantId, sprintId])
  @@map("prj_items")
}

/// Enlaces al repositorio, a los entornos y al diseño. ARZA ONE guarda el enlace, no el código.
model PrjExternalLink {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  kind      String
  url       String
  label     String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?    @map("created_by") @db.Uuid
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String?    @map("updated_by") @db.Uuid
  version   Int        @default(1)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project   PrjProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@map("prj_external_links")
}

/// Registro de horas (B27, ficha 17.8): máximo siete días de atraso; el Líder técnico aprueba.
model PrjTimeEntry {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  itemId       String?    @map("item_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  workDate     DateTime   @map("work_date") @db.Date
  hours        Decimal    @db.Decimal(4, 2)
  billable     Boolean    @default(true)
  note         String?
  status       String     @default("registered")
  decidedBy    String?    @map("decided_by") @db.Uuid
  decidedAt    DateTime?  @map("decided_at") @db.Timestamptz(6)
  decisionNote String?    @map("decision_note")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?    @map("updated_by") @db.Uuid
  version      Int        @default(1)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project      PrjProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  item         PrjItem?   @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, projectId, status])
  @@index([tenantId, userId, workDate])
  @@map("prj_time_entries")
}

/// Entregables (B27): en preparación → entregado → aceptado o devuelto.
model PrjDeliverable {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  projectId    String          @map("project_id") @db.Uuid
  milestoneId  String?         @map("milestone_id") @db.Uuid
  name         String
  description  String?
  versionLabel String?         @map("version_label")
  evidenceUrl  String?         @map("evidence_url")
  status       String          @default("preparing")
  acceptedAt   DateTime?       @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?         @map("created_by") @db.Uuid
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?         @map("updated_by") @db.Uuid
  version      Int             @default(1)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(6)
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project      PrjProject      @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  milestone    PrjMilestone?   @relation(fields: [tenantId, milestoneId], references: [tenantId, id], onDelete: Restrict)
  acceptances  PrjAcceptance[]

  @@unique([tenantId, id])
  @@index([tenantId, projectId])
  @@index([tenantId, milestoneId])
  @@map("prj_deliverables")
}

/// Actas de entrega FT-TEC-001 (B27): el registro del formato, su PDF enviado a firma del cliente
/// (proceso de firma del módulo de Contratos) y la respuesta. Se guardan por identificador.
model PrjAcceptance {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  deliverableId String         @map("deliverable_id") @db.Uuid
  status        String         @default("preparing")
  signerPartyId String         @map("signer_party_id") @db.Uuid
  signerName    String         @map("signer_name")
  environment   String
  pendingNote   String?        @map("pending_note")
  message       String?
  respondBy     DateTime       @map("respond_by") @db.Date
  formRecordId  String?        @map("form_record_id") @db.Uuid
  recordCode    String?        @map("record_code")
