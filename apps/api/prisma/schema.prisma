  /// Jefe inmediato al radicar; vacío si decide Talento humano.
  approverId    String?    @map("approver_id") @db.Uuid
  requestedBy   String     @map("requested_by") @db.Uuid
  decidedBy     String?    @map("decided_by") @db.Uuid
  decidedAt     DateTime?  @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?    @map("decision_note")
  supportFileId String?    @map("support_file_id") @db.Uuid
  requestKey    String     @map("request_key")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?    @map("created_by") @db.Uuid
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?    @map("updated_by") @db.Uuid
  version       Int        @default(1)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee      HrEmployee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, requestKey])
  @@index([tenantId, employeeId])
  @@index([tenantId, approverId, status])
  @@index([tenantId, status])
  @@map("hr_leave_requests")
}

