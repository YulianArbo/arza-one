{
  "name": "@arza/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:int": "prisma generate && vitest run --config vitest.int.config.ts --coverage",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env dist/platform/database/seed/seed-main.js",
    "db:seed:demo": "node --env-file-if-exists=../../.env dist/platform/database/seed/seed-main.js --demo"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2.7",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "prisma": "~7.10.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@arza/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@nestjs/common": "~11.2.7",
    "@nestjs/core": "~11.2.7",
    "@nestjs/platform-express": "~11.2.7",
    "@nestjs/swagger": "~11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "bullmq": "^6.3.11",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
