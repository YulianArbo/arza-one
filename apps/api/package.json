{
  "name": "@arza/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "data"
  ],
  "exports": {
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./iam": {
      "types": "./dist/modules/iam/index.d.ts",
      "default": "./dist/modules/iam/index.js"
    },
    "./audit": {
      "types": "./dist/modules/audit/index.d.ts",
      "default": "./dist/modules/audit/index.js"
    },
    "./doc": {
      "types": "./dist/modules/doc/index.d.ts",
      "default": "./dist/modules/doc/index.js"
    },
    "./wf": {
      "types": "./dist/modules/wf/index.d.ts",
      "default": "./dist/modules/wf/index.js"
    },
    "./ntf": {
      "types": "./dist/modules/ntf/index.d.ts",
      "default": "./dist/modules/ntf/index.js"
    },
    "./crm": {
      "types": "./dist/modules/crm/index.d.ts",
      "default": "./dist/modules/crm/index.js"
    },
    "./contract": {
      "types": "./dist/modules/contract/index.d.ts",
      "default": "./dist/modules/contract/index.js"
    },
    "./project": {
      "types": "./dist/modules/project/index.d.ts",
      "default": "./dist/modules/project/index.js"
    },
    "./service": {
      "types": "./dist/modules/service/index.d.ts",
      "default": "./dist/modules/service/index.js"
    },
    "./asset": {
      "types": "./dist/modules/asset/index.d.ts",
      "default": "./dist/modules/asset/index.js"
    },
    "./hr": {
      "types": "./dist/modules/hr/index.d.ts",
      "default": "./dist/modules/hr/index.js"
    },
    "./sst": {
      "types": "./dist/modules/sst/index.d.ts",
      "default": "./dist/modules/sst/index.js"
    },
    "./qms": {
      "types": "./dist/modules/qms/index.d.ts",
      "default": "./dist/modules/qms/index.js"
    },
    "./inn": {
      "types": "./dist/modules/inn/index.d.ts",
      "default": "./dist/modules/inn/index.js"
    },
    "./web": {
      "types": "./dist/modules/web/index.d.ts",
      "default": "./dist/modules/web/index.js"
    },
    "./privacy": {
      "types": "./dist/modules/privacy/index.d.ts",
      "default": "./dist/modules/privacy/index.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts --coverage",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "node ../../infra/scripts/local/dev-watch.ts dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env dist/platform/database/seed/seed-main.js",
    "db:seed:demo": "node --env-file-if-exists=../../.env dist/platform/database/seed/seed-main.js --demo",
    "iam:invitar": "node --env-file-if-exists=../../.env dist/modules/iam/interface/cli/invite-main.js",
    "iam:asignar-rol": "node --env-file-if-exists=../../.env dist/modules/iam/interface/cli/assign-role-main.js",
    "contratos:vincular-firmante": "node --env-file-if-exists=../../.env dist/modules/contract/interface/cli/link-signer-main.js",
    "iam:reiniciar-segundo-factor": "node --env-file-if-exists=../../.env dist/modules/iam/interface/cli/reset-second-factor-main.js",
    "doc:importar-listado": "node --env-file-if-exists=../../.env dist/modules/doc/interface/cli/import-master-list-main.js",
    "doc:importar-retencion": "node --env-file-if-exists=../../.env dist/modules/doc/interface/cli/import-retention-main.js"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2.7",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "pizzip": "^3.3.0",
    "prisma": "~7.10.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@arza/contracts": "workspace:*",
    "@arza/templates": "workspace:*",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@casl/ability": "~7.1.0",
    "@nestjs/common": "~11.2.7",
    "@nestjs/core": "~11.2.7",
    "@nestjs/platform-express": "~11.2.7",
    "@nestjs/swagger": "~11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "bullmq": "^6.3.11",
    "decimal.js": "~10.6.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "otpauth": "~9.6.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.7"
  }
}
