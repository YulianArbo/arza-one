# Variables de entorno de ARZA ONE (anexo F del manual).
# Copie este archivo como .env y reemplace los valores. Todos los valores de aquí son ficticios.
# Los valores reales nunca se guardan en el repositorio: viven en el gestor de contraseñas.

# Ambiente
NODE_ENV=development
APP_ENV=local

# Direcciones de cada superficie. La web (B04) sirve el sitio en /, la aplicación interna en /app
# y el portal en /portal. API_URL es también la dirección que usa el navegador para pedir datos.
APP_URL=http://localhost:3000/app
PORTAL_URL=http://localhost:3000/portal
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000

# API: puerto local, nivel de registros (fatal, error, warn, info, debug, trace) y commit desplegado.
# Son opcionales; estos son sus valores por defecto. GIT_COMMIT lo fija el despliegue (B07).
API_PORT=4000
LOG_LEVEL=info
GIT_COMMIT=unknown

# Base de datos (secreto). La API usa app_user; las migraciones, migration_user (B03).
DATABASE_URL=postgresql://app_user:REEMPLAZAR@localhost:5432/arza_one
DATABASE_MIGRATION_URL=postgresql://migration_user:REEMPLAZAR@localhost:5432/arza_one

# Base de datos local en Docker (secretos). Las lee infra/postgres/init al crear la base:
# superusuario, app_user y migration_user. Deben coincidir con las contraseñas de arriba.
POSTGRES_PASSWORD=REEMPLAZAR
APP_DB_PASSWORD=REEMPLAZAR
MIGRATION_DB_PASSWORD=REEMPLAZAR

# Colas y caché (secreto)
VALKEY_URL=redis://localhost:6379

# Almacenamiento de archivos
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=arza-one-local
S3_ACCESS_KEY=REEMPLAZAR
S3_SECRET_KEY=REEMPLAZAR

# Sesión, cifrado y firma (secretos)
SESSION_SECRET=REEMPLAZAR
CSRF_SECRET=REEMPLAZAR
FIELD_ENCRYPTION_KEY=REEMPLAZAR
SIGNATURE_HMAC_KEY=REEMPLAZAR
PDF_SEAL_CERT=REEMPLAZAR
PDF_SEAL_KEY=REEMPLAZAR

# Correo (en desarrollo se usa Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ARZA ONE <no-responder@arza-one.test>

# Servicios internos
GOTENBERG_URL=http://localhost:3001
CLAMAV_HOST=localhost

# Captura de errores (secreto)
GLITCHTIP_DSN=

# Copias de seguridad (secretos)
BACKUP_REPOSITORY=
BACKUP_PASSWORD=

# Protección
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Región
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_LOCALE=es-CO
DEFAULT_CURRENCY=COP
