# Variables de entorno de ARZA ONE (anexo F del manual).
# En el equipo local, `pnpm env:local` crea .env a partir de este archivo y cambia cada
# REEMPLAZAR por una contraseña al azar. Todos los valores de aquí son ficticios.
# Los valores reales nunca se guardan en el repositorio: viven en el gestor de contraseñas.

# Ambiente
NODE_ENV=development
APP_ENV=local

# Direcciones de cada superficie. La web (B04) sirve el sitio en /, la aplicación interna en /app
# y el portal en /portal. API_URL es también la dirección que usa el navegador para pedir datos.
APP_URL=http://localhost:3000/app
PORTAL_URL=http://localhost:3000/portal
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000

# NIT de la empresa dueña del sitio público (B29): allí llegan las PQRSF que se radican sin sesión.
# En el equipo local es el NIT ficticio de la empresa semilla; en producción, el NIT real registrado
# en Administración. Vacío: el formulario público de PQRSF responde que no está disponible.
PUBLIC_SITE_TAX_ID=900000000-0

# API: puerto local, nivel de registros (fatal, error, warn, info, debug, trace) y commit desplegado.
# Son opcionales; estos son sus valores por defecto. GIT_COMMIT lo fija el despliegue (B07).
API_PORT=4000
LOG_LEVEL=info
GIT_COMMIT=unknown

# Base de datos (secreto). La API usa app_user; las migraciones, migration_user (B03).
DATABASE_URL=postgresql://app_user:REEMPLAZAR@localhost:5432/arza_one
DATABASE_MIGRATION_URL=postgresql://migration_user:REEMPLAZAR@localhost:5432/arza_one
# Esperas de la API con la base de datos, en milisegundos (opcionales, B31). Sin definirlas rigen
# 2000 ms para obtener una conexión y los límites de transacción por defecto de Prisma. Las
# pruebas de integración las amplían; no las cambie en producción sin medir.
# DATABASE_CONNECT_TIMEOUT_MS=2000
# DATABASE_TRANSACTION_MAX_WAIT_MS=
# DATABASE_TRANSACTION_TIMEOUT_MS=

# Base de datos local en Docker (secretos). Las lee infra/postgres/init al crear la base:
# superusuario, app_user y migration_user. Deben coincidir con las contraseñas de arriba.
# Si cambia una después de `pnpm infra:up`, ejecute `pnpm infra:reset` (la base ya existe).
POSTGRES_PASSWORD=REEMPLAZAR
APP_DB_PASSWORD=REEMPLAZAR
MIGRATION_DB_PASSWORD=REEMPLAZAR

# Colas y caché (secretos). La contraseña de VALKEY_URL debe ser la de VALKEY_PASSWORD.
VALKEY_PASSWORD=REEMPLAZAR
VALKEY_URL=redis://:REEMPLAZAR@localhost:6379

# Almacenamiento de archivos (Garage). La llave de acceso tiene el formato GK + 24 caracteres
# hexadecimales y el secreto, 64 hexadecimales; `pnpm infra:up` la registra en Garage.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=arza-one-local
S3_ACCESS_KEY=REEMPLAZAR
S3_SECRET_KEY=REEMPLAZAR

# Garage local (secretos). GARAGE_RPC_SECRET: 64 caracteres hexadecimales.
GARAGE_RPC_SECRET=REEMPLAZAR
GARAGE_ADMIN_TOKEN=REEMPLAZAR

# Sesión, cifrado y firma (secretos)
SESSION_SECRET=REEMPLAZAR
CSRF_SECRET=REEMPLAZAR
FIELD_ENCRYPTION_KEY=REEMPLAZAR
SIGNATURE_HMAC_KEY=REEMPLAZAR
PDF_SEAL_CERT=REEMPLAZAR
PDF_SEAL_KEY=REEMPLAZAR

# Correo (en desarrollo se usa Mailpit; su bandeja se ve en http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ARZA ONE <no-responder@arza-one.test>

# Servicios internos
GOTENBERG_URL=http://localhost:3001
CLAMAV_HOST=localhost

# Sello de los PDF firmados (secretos, B43): certificado PKCS#12 de la empresa en base64 y su clave.
# Vacíos fuera de producción: el worker usa un certificado temporal sin validez.
PDF_SEAL_PKCS12=
PDF_SEAL_PASSPHRASE=

# Captura de errores (secreto)
GLITCHTIP_DSN=

# Copias de seguridad (secretos)
BACKUP_REPOSITORY=
BACKUP_PASSWORD=

# Protección
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Región
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_LOCALE=es-CO
DEFAULT_CURRENCY=COP

# Puertos del entorno local (opcionales; estos son los valores por defecto). Cambie uno si ya
# está ocupado en su equipo; si cambia POSTGRES_PORT, VALKEY_PORT, GARAGE_S3_PORT, SMTP_PORT o
# GOTENBERG_PORT, use el mismo número en las direcciones de arriba.
POSTGRES_PORT=5432
VALKEY_PORT=6379
GARAGE_S3_PORT=3900
GOTENBERG_PORT=3001
CLAMAV_PORT=3310
MAILPIT_UI_PORT=8025
